---
import ArtikelLayout from '../../../layouts/ArtikelLayout.astro';
import { siteConfig, prefixedLocales } from '../../../config/site';
import { getArticles } from '../../../lib/content';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of prefixedLocales) {
    for (const tab of siteConfig.tabs) {
      for (const item of await getArticles(tab.slug, lang)) {
        paths.push({
          params: { lang, tab: tab.slug, slug: item.slug },
          props: {
            entry: item.entry,
            slug: item.slug,
            isFallback: item.isFallback,
            gambar: item.gambar,
            kartuShare: item.kartuShare,
          },
        });
      }
    }
  }
  return paths;
}

const { entry, slug, isFallback, gambar, kartuShare } = Astro.props;
---

<ArtikelLayout entry={entry} slug={slug} isFallback={isFallback} gambar={gambar} kartuShare={kartuShare}>
  <Fragment set:html={entry.bodyHtml} />
</ArtikelLayout>
