---
/**
 * Halaman privasi, locale BERPREFIKS (`/en/privasi/`).
 *
 * Pasangan `privasi.astro` di akar, tanpa syarat tambahan apa pun — properti
 * "kedua locale menerbitkan jumlah halaman yang sama" yang dijaga gerbang
 * resiprositas hreflang di `audit:konten`.
 */
import HalamanPrivasi from '../../components/views/HalamanPrivasi.astro';
import { prefixedLocales } from '../../config/site';

export function getStaticPaths() {
  return prefixedLocales.map((lang) => ({ params: { lang } }));
}
