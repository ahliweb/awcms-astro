---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SyaratList from '../components/SyaratList.astro';
import ProcedureSteps from '../components/ProcedureSteps.astro';
import BiayaTable from '../components/BiayaTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import DisclaimerNote from '../components/DisclaimerNote.astro';
import TranslationNotice from '../components/TranslationNotice.astro';
import { getLocaleFromPath, getSiteUrl, localePath, localeHtmlLang, siteConfig, tabTitleKey } from '../config/site';
import { getArticleImage } from '../lib/article-images';
import { SITE_SOCIAL_IMAGE } from '../lib/social-image';
import { articleSchema } from '../lib/schema';
import { t } from '../lib/po';
import type { LocalizedArticle } from '../lib/content';

interface Props {
  entry: LocalizedArticle['entry'];
  slug: string;
  isFallback?: boolean;
}

const { entry, slug, isFallback = false } = Astro.props;
const data = entry.data;
const locale = getLocaleFromPath(Astro.url.pathname);

const articleVisual = getArticleImage(data.kategori, slug);
const shareCard = SITE_SOCIAL_IMAGE;
const canonicalUrl = getSiteUrl(localePath(locale, `/${data.kategori}/${slug}/`));

// Nama tab datang dari katalog PO lewat konfigurasi tab, bukan dari peta
// harfiah. Yang ada di sini sebelumnya adalah lima tab repo rujukan
// (`sim`, `stnk`, `bpkb`, …) yang tidak pernah cocok dengan tab template ini,
// sehingga setiap judul dan breadcrumb jatuh ke `kategori.toUpperCase()` —
// terbaca, tetapi tidak pernah diterjemahkan.
const tabConfig = siteConfig.tabs.find((tab) => tab.slug === data.kategori);
const tabName = t(locale, tabTitleKey(data.kategori), tabConfig?.label ?? data.kategori);
const pageTitle = `${data.title} | ${tabName}`;

const breadcrumbItems = [
  { name: tabName, url: localePath(locale, `/${data.kategori}/`) },
  { name: data.title, url: localePath(locale, `/${data.kategori}/${slug}/`) }
];

const dateFormat: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};

const updatedDateStr = new Date(data.updatedDate).toLocaleDateString(localeHtmlLang[locale], dateFormat);
const reviewDueDateStr = data.reviewDueDate
  ? new Date(data.reviewDueDate).toLocaleDateString(localeHtmlLang[locale], dateFormat)
  : undefined;

const schema = articleSchema({
  locale,
  canonicalUrl,
  title: data.title,
  description: data.description,
  image: shareCard,
  imageAlt: articleVisual.alt,
  updatedDate: new Date(data.updatedDate),
  section: tabName,
});
---

<BaseLayout
  title={pageTitle}
  description={data.description}
  currentTab={data.kategori}
  ogType="article"
  ogImage={shareCard}
  ogImageAlt={articleVisual.alt}
  schema={schema}
  articleMeta={{
    modifiedTime: new Date(data.updatedDate).toISOString(),
    section: tabName,
  }}
>
  <article>
    <Breadcrumb items={breadcrumbItems} />

    {isFallback && <TranslationNotice />}

    <header style="margin: 1.5rem 0; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color);">
      <div class="article-hero-frame">
        <div class="visual-placeholder visual-hero" role="img" aria-label={articleVisual.alt}></div>
      </div>

      <h1 class="artikel-title">{data.title}</h1>
      <p class="artikel-lead">{data.description}</p>

      {/* Setiap baris metadata tampil hanya bila nilainya ada. Baris tinjau
          ulang dulu tanpa syarat, sehingga artikel tanpa `reviewDueDate`
          menampilkan labelnya dengan nilai kosong di belakangnya — sebuah
          janji tinjauan yang tidak pernah dibuat siapa pun.

          Dua baris lain yang pernah ada di sini (`variasiWilayah` dan
          `unitPelaksana`) membaca field yang tidak ada di kontrak
          `LocalizedArticle`. Keduanya selalu bernilai `undefined`, jadi tidak
          pernah tampil, dan `entry: any` membuat typecheck tidak bisa
          mengatakannya. */}
      <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: 0.85rem; color: var(--text-muted); margin-top: 1rem;">
        <div>📅 {t(locale, 'artikel.updated')} <strong>{updatedDateStr}</strong></div>
        {reviewDueDateStr && <div>🔍 {t(locale, 'artikel.review')} <strong>{reviewDueDateStr}</strong></div>}
        {data.estimasiWaktu && <div>⏱️ {t(locale, 'artikel.estimasi')} <strong>{data.estimasiWaktu}</strong></div>}
      </div>
    </header>

    <div class="content-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--text-primary);">
      <slot />
    </div>

    <SyaratList syarat={data.syaratDokumen} />

    <ProcedureSteps steps={data.langkah} />

    <BiayaTable biaya={data.biaya} dasarHukum={data.dasarHukum} />

    <FaqAccordion faq={data.faq} />

    <DisclaimerNote variant="general" />
  </article>
</BaseLayout>
