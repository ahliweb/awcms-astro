---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SyaratList from '../components/SyaratList.astro';
import ProcedureSteps from '../components/ProcedureSteps.astro';
import BiayaTable from '../components/BiayaTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import DisclaimerNote from '../components/DisclaimerNote.astro';
import TranslationNotice from '../components/TranslationNotice.astro';
import Ilustrasi from '../components/Ilustrasi.astro';
import { getLocaleFromPath, getSiteUrl, localePath, siteConfig, tabTitleKey, urutanSeksiTab } from '../config/site';
import { seksiPunyaFeed } from '../lib/feed';
import { jalurFeed } from '../lib/feed-seksi';
import { tanggalPanjang, tanggalMesin, pernahDiubahSetelahTerbit } from '../lib/tanggal';
import { getArticleVisual } from '../lib/article-images';
import { SITE_SOCIAL_IMAGE } from '../lib/social-image';
import { articleSchema, tipeArtikelSeksi } from '../lib/schema';
import { profilSitus } from '../lib/awcms/profil';
import { namaPenerbit, namaSitus } from '../lib/identitas';
import { t } from '../lib/po';
import type { LocalizedArticle } from '../lib/content';

interface Props {
  entry: LocalizedArticle['entry'];
  slug: string;
  isFallback?: boolean;
  /** Gambar hasil resolusi awcms; `undefined` jatuh ke seni lokal lalu placeholder. */
  gambar?: LocalizedArticle['gambar'];
  /** Kartu share artikel ini; `undefined` jatuh ke kartu situs, lalu ke tanpa gambar. */
  kartuShare?: LocalizedArticle['kartuShare'];
}

const { entry, slug, isFallback = false, gambar, kartuShare } = Astro.props;
const data = entry.data;
const locale = getLocaleFromPath(Astro.url.pathname);

const articleVisual = getArticleVisual({ gambar }, data.kategori, slug);
// Kartu artikel diteruskan utuh; `BaseLayout` yang jatuh ke kartu situs saat
// artikel ini tidak punya. Yang TIDAK boleh dilakukan di sini adalah memilih
// URL-nya sendiri lalu menyerahkan alt secara terpisah — itu yang membuat
// halaman ini sempat memasang alt hero artikel pada kartu situs.
const canonicalUrl = getSiteUrl(localePath(locale, `/${data.kategori}/${slug}/`));

// Nama tab datang dari katalog PO lewat konfigurasi tab, bukan dari peta
// harfiah. Yang ada di sini sebelumnya adalah lima tab repo rujukan
// (`sim`, `stnk`, `bpkb`, …) yang tidak pernah cocok dengan tab template ini,
// sehingga setiap judul dan breadcrumb jatuh ke `kategori.toUpperCase()` —
// terbaca, tetapi tidak pernah diterjemahkan.
const tabConfig = siteConfig.tabs.find((tab) => tab.slug === data.kategori);
const tabName = t(locale, tabTitleKey(data.kategori), tabConfig?.label ?? data.kategori);
const pageTitle = `${data.title} | ${tabName}`;

const breadcrumbItems = [
  { name: tabName, url: localePath(locale, `/${data.kategori}/`) },
  { name: data.title, url: localePath(locale, `/${data.kategori}/${slug}/`) }
];

const publishedDate = new Date(data.publishedDate);
const modifiedDate = new Date(data.updatedDate);

const publishedDateStr = tanggalPanjang(locale, publishedDate);

// Baris "diperbarui" hanya tampil bila artikel ini memang pernah diubah
// SETELAH terbit, dan pembandingnya tanggal — bukan milidetik. `updated_at` di
// awcms bergerak pada setiap tulis, termasuk transisi status yang menerbitkan
// artikel itu sendiri, jadi setiap artikel yang baru terbit membawa dua stempel
// yang berbeda beberapa milidetik. Membandingkan nilai mentah akan memasang
// "Diperbarui" pada setiap artikel sejak menit pertamanya — sebuah koreksi yang
// tidak pernah terjadi, di setiap halaman.
const diperbarui = pernahDiubahSetelahTerbit(publishedDate, modifiedDate);
const modifiedDateStr = diperbarui ? tanggalPanjang(locale, modifiedDate) : undefined;

const reviewDueDateStr = data.reviewDueDate
  ? tanggalPanjang(locale, new Date(data.reviewDueDate))
  : undefined;

const schema = articleSchema({
  locale,
  canonicalUrl,
  title: data.title,
  description: data.description,
  image: kartuShare?.src ?? SITE_SOCIAL_IMAGE,
  imageAlt: kartuShare?.alt ?? t(locale, 'share.imageAlt'),
  imageWidth: kartuShare?.width,
  imageHeight: kartuShare?.height,
  publishedDate,
  modifiedDate,
  section: tabName,
  // Keputusannya milik `src/lib/schema.ts`, bukan baris ini: `.astro` tidak
  // dijangkau typecheck maupun tes, jadi terner di sini adalah keputusan yang
  // bisa dibalik tanpa satu gerbang pun berubah warna.
  tipe: tipeArtikelSeksi(data.kategori),
  // Nama penerbit datang dari `site_profile` (`awcms` #596), bukan dari
  // `siteConfig.name` yang ditulis di source — lihat `articleSchema`. Panggilan
  // ini dimemoisasi per build; `BaseLayout` sudah memintanya lebih dulu.
  penerbit: namaPenerbit(await profilSitus()),
});

// Feed seksi ini, diumumkan juga dari halaman artikelnya (ADR-0035) — tempat
// seorang pembaca justru paling mungkin memutuskan untuk berlangganan.
//
// Syarat "seksinya berisi artikel" terpenuhi menurut konstruksi di sini: yang
// merender halaman ini adalah salah satu artikel seksi itu. Angka `1` karena
// itu bukan perkiraan melainkan batas bawah yang benar-benar diketahui, dan
// memanggil `getArticles` lagi hanya untuk menghitungnya akan menambah
// pekerjaan per halaman untuk menjawab pertanyaan yang sudah terjawab.
const feed = seksiPunyaFeed(urutanSeksiTab(data.kategori), 1)
  ? { judul: `${tabName} — ${namaSitus(await profilSitus())}`, href: jalurFeed(locale, data.kategori) }
  : undefined;
---

<BaseLayout
  title={pageTitle}
  description={data.description}
  currentTab={data.kategori}
  ogType="article"
  shareCard={kartuShare}
  schema={schema}
  articleMeta={{
    publishedTime: publishedDate.toISOString(),
    modifiedTime: modifiedDate.toISOString(),
    section: tabName,
  }}
  feed={feed}
>
  <article>
    <Breadcrumb items={breadcrumbItems} />

    {isFallback && <TranslationNotice />}

    <header class="artikel-kepala">
      <div class="article-hero-frame">
        <Ilustrasi
          src={articleVisual.src}
          alt={articleVisual.alt}
          width={articleVisual.width}
          height={articleVisual.height}
          hero
        />
      </div>

      <h1 class="artikel-title">{data.title}</h1>
      <p class="artikel-lead">{data.description}</p>

      {/* Setiap baris metadata tampil hanya bila nilainya ada. Baris tinjau
          ulang dulu tanpa syarat, sehingga artikel tanpa `reviewDueDate`
          menampilkan labelnya dengan nilai kosong di belakangnya — sebuah
          janji tinjauan yang tidak pernah dibuat siapa pun.

          Dua baris lain yang pernah ada di sini (`variasiWilayah` dan
          `unitPelaksana`) membaca field yang tidak ada di kontrak
          `LocalizedArticle`. Keduanya selalu bernilai `undefined`, jadi tidak
          pernah tampil, dan `entry: any` membuat typecheck tidak bisa
          mengatakannya. */}
      <div class="artikel-meta">
        <div>📅 {t(locale, 'artikel.diterbitkan')} <strong><time datetime={tanggalMesin(publishedDate)}>{publishedDateStr}</time></strong></div>
        {modifiedDateStr && <div>✏️ {t(locale, 'artikel.updated')} <strong><time datetime={tanggalMesin(modifiedDate)}>{modifiedDateStr}</time></strong></div>}
        {reviewDueDateStr && <div>🔍 {t(locale, 'artikel.review')} <strong>{reviewDueDateStr}</strong></div>}
        {data.estimasiWaktu && <div>⏱️ {t(locale, 'artikel.estimasi')} <strong>{data.estimasiWaktu}</strong></div>}
      </div>
    </header>

    <div class="content-body artikel-isi">
      <slot />
    </div>

    <SyaratList syarat={data.syaratDokumen} />

    <ProcedureSteps steps={data.langkah} />

    <BiayaTable biaya={data.biaya} dasarHukum={data.dasarHukum} />

    <FaqAccordion faq={data.faq} />

    <DisclaimerNote variant="general" />
  </article>
</BaseLayout>

<style>
  .artikel-kepala {
    margin: 1.5rem 0;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .artikel-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 1rem;
  }

  .artikel-isi {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-primary);
  }
</style>
