---
import TabNav from '../components/TabNav.astro';
import DisclaimerNote from '../components/DisclaimerNote.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import ShareButtons from '../components/ShareButtons.astro';
import BeaconKunjungan from '../components/BeaconKunjungan.astro';
import FormBuletin from '../components/FormBuletin.astro';
import {
  siteConfig,
  getSiteUrl,
  getLocaleFromPath,
  localePath,
  swapLocalePath,
  localeHtmlLang,
  localeMeta,
  locales,
  defaultLocale,
  tabTitleKey,
  SEGMEN_CARI,
  SEGMEN_PRIVASI,
  pencarianAktif,
  type Locale,
} from '../config/site';
import { t } from '../lib/po';
import { kartuSitus, type KartuShare } from '../lib/social-image';
import { siteSchema } from '../lib/schema';
import { profilSitus } from '../lib/awcms/profil';
import {
  adaKontak,
  barisCopyright,
  namaSitus,
  taglineSitus,
  tautanTelepon,
  tautanWhatsapp,
} from '../lib/identitas';
import { daftarMenu, daftarWidget, peringatkanSekali } from '../lib/awcms/navigasi';
import { menuDenganKey, pesanTerbuang, susunMenu } from '../lib/menu';
import { indeksPost } from '../lib/content';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentTab?: string;
  /**
   * Kartu share halaman ini, LENGKAP dengan metadata yang memerikannya.
   *
   * Satu objek dan bukan lima prop, karena selama `src` dan `alt` terpisah
   * keduanya bisa datang dari dua gambar berbeda — dan itu yang terjadi
   * sebelum ini: halaman seksi dan halaman artikel memasang alt hero mereka
   * pada kartu SITUS. Pembaca layar di lini masa sosial mendengar deskripsi
   * gambar yang tidak sedang ditampilkan, dan tidak ada gerbang yang bisa
   * melihatnya — kedua tag ada dan keduanya masuk akal dibaca sendiri.
   *
   * Kosong berarti halaman ini tidak memasang tag gambar sama sekali; itu
   * keadaan yang didukung dan merupakan bawaan template.
   */
  shareCard?: KartuShare | undefined;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  /** JSON-LD tambahan khas halaman ini (Article, ItemList, Place, …). */
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  /**
   * Metadata `article:*` Open Graph; hanya diisi halaman artikel.
   *
   * `tags` opsional: kontrak `AwcmsAstroBlock` belum membawa tag, jadi memaksa
   * pemanggil mengirim `[]` hanya menyamarkan ketiadaannya sebagai daftar
   * kosong yang disengaja.
   */
  articleMeta?: {
    publishedTime: string;
    modifiedTime: string;
    section: string;
    tags?: string[];
  };
  /** Menyembunyikan tombol bagikan; dipakai halaman yang tidak layak dibagikan. */
  hideShare?: boolean;
  /**
   * Tautan penemuan-otomatis ke feed seksi ini, bila seksinya menerbitkan feed
   * (ADR-0035). Kosong berarti tidak ada tag `rel="alternate"` feed sama sekali
   * — keadaan bawaan template, yang menyatakan nol seksi berita.
   *
   * Ia dikirim sebagai objek yang sudah berisi `href` DAN judulnya, dengan
   * alasan yang sama seperti `shareCard`: selama keduanya terpisah, keduanya
   * bisa datang dari seksi yang berbeda. Pembaca feed menampilkan `title` ini
   * di daftar langganan, jadi judul yang menyebut seksi lain adalah langganan
   * yang salah nama — dan tidak satu pun gerbang bisa melihatnya, karena kedua
   * atribut ada dan keduanya masuk akal dibaca sendiri.
   */
  feed?: { judul: string; href: string } | undefined;
  /**
   * Halaman yang tidak boleh masuk indeks (404). Selain memasang `noindex`,
   * canonical dan hreflang ikut dilepas: halaman 404 Bahasa Indonesia disajikan
   * host sebagai `/404.html`, bukan `/404/`, sehingga alternate-nya akan
   * menunjuk URL yang tidak ada.
   */
  noindex?: boolean;
  /** Path yang dipakai pengalih bahasa bila path halaman ini bukan URL nyata. */
  langSwitchPath?: string;
}

const locale = getLocaleFromPath(Astro.url.pathname);
const pathname = Astro.url.pathname;

const {
  title,
  description = t(locale, 'home.description'),
  currentTab,
  shareCard,
  canonicalUrl = getSiteUrl(pathname.endsWith('/') ? pathname : `${pathname}/`),
  ogType = 'website',
  schema,
  articleMeta,
  hideShare = false,
  noindex = false,
  langSwitchPath,
  feed,
} = Astro.props;

// Identitas situs datang dari `awcms` (`site_profile`, #596), dengan
// konfigurasi sebagai cadangan. Versi paling awal menuliskan nama repo rujukan
// di sini secara harfiah, sehingga SETIAP judul halaman di SETIAP situs yang
// lahir dari template ini berakhiran nama situs orang lain — tanpa satu pun
// peringatan build; versi berikutnya memindahkannya ke `.env`, yang menutup
// cacat itu dan menyisakan yang ini: identitas hanya bisa diganti oleh orang
// yang bisa menyunting deployment, bukan oleh redaksi yang memilikinya.
//
// Sekali per build (dimemoisasi), meski setiap halaman di setiap locale
// memanggilnya.
const profil = await profilSitus();
const namaSitusIni = namaSitus(profil);

// Navigasi sekunder dan widget dari CMS (`awcms` #597 butir 6, ADR-0105 di
// sana). Bilah tab TIDAK diganti: sebuah item menu `awcms` membawa satu label
// tanpa varian per-locale, jadi navigasi utama yang digerakkan CMS akan
// mengembalikan antarmuka primer situs ini ke satu bahasa.
//
// Ketiga panggilan di-memoise per build, jadi merendernya di setiap halaman
// tidak menambah satu pun permintaan.
const menuFooter = menuDenganKey(await daftarMenu(), 'footer');
const hasilMenu = menuFooter
  ? susunMenu(menuFooter, await indeksPost(), locale)
  : undefined;

// SEKALI per build, bukan sekali per halaman: apa yang terbuang diketahui saat
// render, dan sebuah situs merender ratusan halaman. Diukur pada build
// verifikasi: 108 halaman, 108 salinan pesan yang identik — yang menenggelamkan
// log build, satu-satunya tempat pesan ini sampai ke editor yang bisa
// memperbaikinya.
const peringatanMenu = hasilMenu
  ? pesanTerbuang(menuFooter!.key, hasilMenu.terbuang)
  : null;
if (peringatanMenu) peringatkanSekali(menuFooter!.key, peringatanMenu);

// Nonaktif disaring DI SINI, bukan di endpoint: `awcms` mengembalikan keduanya
// dengan sengaja, supaya "dimatikan" dan "dihapus" tidak menjadi jawaban yang
// sama.
const widgetSemua = (await daftarWidget()).filter((widget) => widget.isActive);
const widgetFooter = widgetSemua.filter((widget) => widget.position === 'footer');
const widgetHeader = widgetSemua.filter((widget) => widget.position === 'header');

const fullTitle = title.includes(namaSitusIni)
  ? title
  : `${title} — ${namaSitusIni}`;

const metaDescription = description.slice(0, 160);

// Kartu halaman, atau kartu situs, atau tidak sama sekali — dan `alt` selalu
// ikut kartunya. `share.imageAlt` memerikan kartu SITUS, jadi ia hanya dipakai
// bersama kartu situs; halaman yang membawa kartunya sendiri membawa alt-nya
// sendiri juga.
const kartu = shareCard ?? kartuSitus(t(locale, 'share.imageAlt'));

// hreflang: setiap halaman punya pasangan di seluruh locale karena route
// dibangun berpasangan, jadi alternate selalu valid.
const alternates = locales.map((loc: Locale) => ({
  hreflang: localeHtmlLang[loc],
  href: getSiteUrl(swapLocalePath(pathname, loc)),
}));

// og:locale memakai bentuk `xx_YY`, dan sumbernya `htmlLang` di localeMeta —
// bukan daftar if/else. Sebuah locale baru cukup ditambahkan di satu tempat.
const ogLocale = localeMeta[locale].htmlLang.replace('-', '_');

// Satu blok JSON-LD per halaman: identitas situs selalu ada, skema khas halaman
// digabung di belakangnya. Crawler membaca @graph sebagai satu kesatuan.
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...siteSchema(locale, canonicalUrl, profil), ...pageSchemas],
};
---

<!DOCTYPE html>
<html lang={localeHtmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Favicon tenant bila ada, berkas template bila tidak. `type` datang dari
        registri media dan bukan ditebak dari ekstensi: `awcms` sudah menyimpan
        MIME hasil sniffing saat unggah, dan menebaknya di sini akan membuat
        satu-satunya nilai yang pernah salah justru yang paling sulit dilihat. */}
    {profil.favicon
      ? <link rel="icon" type={profil.favicon.mimeType} href={profil.favicon.publicUrl} />
      : <link rel="icon" type="image/svg+xml" href="/favicon.svg" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    {!noindex && alternates.map((alt: { hreflang: string; href: string }) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {/* x-default menunjuk locale default repo ini, apa pun kodenya — bukan
        `'id'` yang dulu ditulis harfiah di sini. Situs yang mengubah
        `defaultLocale` tanpa menyentuh baris ini akan mengarahkan crawler ke
        bahasa yang bukan bahasa sumbernya. */}
    {!noindex && <link rel="alternate" hreflang="x-default" href={getSiteUrl(swapLocalePath(pathname, defaultLocale))} />}

    {/* Penemuan-otomatis feed (ADR-0035). Ia SENGAJA tidak membawa `hreflang`:
        gerbang resiprositas di `audit:konten` mengumpulkan setiap
        `rel="alternate"` yang ber-hreflang dan menuntut pasangannya membalas,
        dan sebuah feed bukan terjemahan halaman ini. Yang membedakan keduanya
        bagi perayap adalah `type`, bukan `rel`. */}
    {feed && <link rel="alternate" type="application/atom+xml" title={feed.judul} href={feed.href} />}

    {/* Open Graph / Facebook.

        Tag gambar hanya dipasang bila kartunya benar-benar ada. Template ini
        tidak membawa pembangkit kartu, dan versi sebelumnya tetap memasang
        `og:image` ke `/social/<slug>.png` yang tidak pernah dibangkitkan
        siapa pun — pratinjau rusak di setiap halaman, dengan build hijau.
        Kartu share diisi lewat `SITE_SOCIAL_IMAGE`; lihat `.env.example`.

        Saat ada, ia wajib PNG dengan ukuran eksplisit: pengunduh pratinjau
        tidak menjalankan JavaScript dan tidak seragam mendukung SVG, dan tanpa
        width/height sebagian menunda render kartunya. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    {kartu && (
      <>
        <meta property="og:image" content={kartu.src} />
        <meta property="og:image:secure_url" content={kartu.src} />
        <meta property="og:image:type" content={kartu.type} />
        {kartu.width && <meta property="og:image:width" content={String(kartu.width)} />}
        {kartu.height && <meta property="og:image:height" content={String(kartu.height)} />}
        <meta property="og:image:alt" content={kartu.alt} />
      </>
    )}
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={namaSitusIni} />
    {articleMeta && (
      <>
        {/* Dua nilai, bukan satu yang dipasang dua kali. Keduanya pernah
            dibaca dari `modifiedTime`, sehingga setiap artikel di setiap situs
            menyatakan bahwa ia tidak pernah diubah sejak terbit — tidak salah
            secara sintaks, tidak terlihat gerbang mana pun, dan tidak pernah
            benar untuk artikel yang dikoreksi (ADR-0033). */}
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        <meta property="article:modified_time" content={articleMeta.modifiedTime} />
        <meta property="article:section" content={articleMeta.section} />
        {(articleMeta.tags ?? []).map((tag: string) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    {/* Twitter. `summary_large_image` menjanjikan gambar besar, jadi tanpa
        kartu yang nyata kartunya diturunkan ke `summary` alih-alih menjanjikan
        gambar yang tidak ada. */}
    <meta name="twitter:card" content={kartu ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {kartu && (
      <>
        <meta name="twitter:image" content={kartu.src} />
        <meta name="twitter:image:alt" content={kartu.alt} />
      </>
    )}

    {/* JSON-LD adalah BLOK DATA, bukan skrip. Browser tidak pernah
        mengeksekusinya — tipe yang bukan MIME JavaScript membuat elemennya
        berhenti di "prepare the script element" sebelum langkah mana pun yang
        menjalankan kode — sehingga `script-src 'self'` tidak memblokir apa pun
        di sini. Ia sengaja TIDAK dipindah ke berkas eksternal: mesin pencari
        membaca JSON-LD dari halamannya, dan berkas terpisah adalah data yang
        tidak dibaca siapa pun. `tests/keluaran-csp.test.mjs` mengizinkan tepat
        tipe ini dan menolak skrip inline lainnya. */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Tema dipasang sebelum paint pertama agar tidak ada kedip (FOUC), jadi
        skrip ini klasik dan tidak ditunda — lihat `public/tema.js` untuk alasan
        ia berkas tersendiri alih-alih blok inline. Tanpa JavaScript atributnya
        tidak terpasang dan tema mengikuti prefers-color-scheme lewat media
        query di global.css. */}
    <script is:inline src="/tema.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(locale, 'ui.skipToMain')}</a>

    {/* Bilah utilitas — pita tipis di atas masthead.

        Ia membawa tiga hal yang dulu berdesakan di baris masthead bersama nama
        situs dan bilah kanal: tagline, pengalih bahasa, pengalih tema. Tidak
        satu pun dari ketiganya adalah navigasi isi, dan memindahkannya ke sini
        adalah yang mengosongkan ruang bagi bilah kanal untuk naik ke baris
        masthead — bukan penambahan hiasan.

        Ia SENGAJA di luar `<header class="header-wrapper">` yang sticky: sebuah
        pita status yang ikut menempel akan memakan 38px dari tinggi layar
        sepanjang halaman digulir, di situs yang mayoritas pembacanya di ponsel. */}
    <div class="bar-utilitas">
      <div class="container bar-utilitas-isi">
        <p class="bar-utilitas-tagline">
          {/* Hiasan, jadi ia tidak punya nama yang dibacakan. */}
          <span class="titik-hidup" aria-hidden="true"></span>
          {taglineSitus(profil, locale)}
        </p>
        <div class="bar-utilitas-aksi">
          <LangSwitcher path={langSwitchPath} />
          <button
            type="button"
            class="chip theme-toggle-btn"
            data-theme-toggle
            aria-label={t(locale, 'ui.themeToggle')}
          >
            <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>
        </div>
      </div>
    </div>

    <header class="header-wrapper">
      <div class="container header-top">
        {/* Lambang dipisahkan dari nama supaya kedua barisnya rata kiri saat
            nama membungkus di layar sempit, dan lambangnya tetap di tengah
            secara vertikal terhadap blok nama — bukan menempel di baris
            pertama. aria-hidden karena ia hiasan: pembaca layar cukup
            mendengar nama situsnya.

            Isinya datang dari `SITE_MARK` dan kosong secara bawaan. Dulu di
            sini ada emoji mobil polisi dan lencana "Kalteng" yang ditulis
            harfiah — atribut sebuah instansi dan sebuah wilayah, terbawa dari
            repo rujukan, tampil di header setiap situs yang lahir dari
            template ini. */}
        <a href={localePath(locale, '/')} class="brand-logo">
          {/* Logo tenant menggantikan lambang `SITE_MARK`, tidak menemaninya:
              keduanya menempati tempat yang sama dan sebuah situs yang memasang
              keduanya menyatakan dua identitas di satu baris. `alt` dikosongkan
              karena nama situs berdiri di sebelahnya sebagai teks — logo yang
              beralt "nama situs" membuat pembaca layar menyebutnya dua kali. */}
          {profil.logo
            ? <img class="brand-logo-img" src={profil.logo.publicUrl} alt="" width={profil.logo.width ?? undefined} height={profil.logo.height ?? undefined} loading="eager" decoding="async" />
            : siteConfig.mark && <span class="brand-mark" aria-hidden="true">{siteConfig.mark}</span>}
          <span class="brand-name">{namaSitusIni}</span>
        </a>

        {/* Bilah kanal berbagi baris dengan nama situs alih-alih menempati
            barisnya sendiri di bawahnya. Itu bukan pemadatan demi ringkas: baris
            kedua yang isinya HANYA bilah kanal membuat setiap halaman membuka
            dengan dua baris kromium sebelum satu kata isi pun muncul, dan di
            layar 360px itu sepertiga lipatan pertama. Ia turun sendiri ke baris
            di bawahnya begitu ruangnya kurang dari 20rem — lihat `.header-top`
            di `global.css`. */}
        <TabNav currentTab={currentTab} />

        <div class="header-actions">
          {/* Tautan, bukan kotak. Sebuah kotak di kepala setiap halaman harus
              disembunyikan tanpa JavaScript (hasilnya butuh JS), dan yang
              tersisa bagi pembaca tanpa JS adalah tidak ada jalan sama sekali.
              Sebuah tautan bekerja tanpa JS: ia mendarat di `/cari/`, yang
              mengatakan dengan jujur apa yang dibutuhkannya.

              Ia BERBENTUK kotak cari — ikon kaca pembesar, latar redam, lebar
              tetap — karena bentuk itu yang dicari mata pembaca di kepala
              halaman. Yang tidak ditiru adalah `<input>`-nya, tepat karena
              alasan di atas.

              Hanya tampil bila build ini punya `awcms` untuk dicari — lihat
              `pencarianAktif`. */}
          {pencarianAktif && (
            <a class="chip cari-tautan" href={localePath(locale, `/${SEGMEN_CARI}/`)}>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              <span>{t(locale, 'cari.tombol')}</span>
            </a>
          )}
        </div>
      </div>

      {widgetHeader.length > 0 && (
        <div class="container">
          <div class="widget-baris">
            {widgetHeader.map((widget) => (
              <div class="widget">
                <h2 class="widget-judul">{widget.title}</h2>
                {/* Teks, tidak pernah markup. `awcms` MENOLAK HTML tidak aman
                    saat tulis alih-alih menyanitasinya, jadi merendernya
                    sebagai HTML di sini akan memberikan kepercayaan yang justru
                    ditolak jalur tulis. Astro meng-escape ekspresi. */}
                {widget.bodyText && <p class="widget-teks">{widget.bodyText}</p>}
              </div>
            ))}
          </div>
        </div>
      )}
    </header>

    <main class="container my-6" id="main-content">
      <slot />
      {!hideShare && <ShareButtons title={fullTitle} url={canonicalUrl} />}
    </main>

    <footer>
      <div class="container">
        <div class="footer-grid">
          <div>
            <h4 class="footer-judul footer-judul--utama">{t(locale, 'footer.about.title')}</h4>
            <p class="footer-teks">
              {t(locale, 'footer.about.body')}
            </p>
          </div>
          <div>
            <h4 class="footer-judul">{t(locale, 'footer.kanal.title')}</h4>
            <ul class="footer-daftar">
              {siteConfig.tabs.map((tab) => (
                <li>
                  <a href={localePath(locale, `/${tab.slug}/`)}>{t(locale, tabTitleKey(tab.slug), tab.label)}</a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h4 class="footer-judul">{t(locale, 'footer.more.title')}</h4>
            <ul class="footer-daftar">
              <li><a href={localePath(locale, '/sitemap/')}>{t(locale, 'footer.sitemap')}</a></li>
              {/* Halaman privasi ditaut TANPA syarat, termasuk pada situs yang
                  tidak menyatakan beacon (ADR-0044). Halaman yang kadang ada dan
                  kadang tidak adalah tautan mati di separuh situs turunan — dan
                  situs yang tidak mengumpulkan apa pun tetap punya sesuatu yang
                  benar untuk dikatakan. */}
              <li><a href={localePath(locale, `/${SEGMEN_PRIVASI}/`)}>{t(locale, 'privasi.judul')}</a></li>
            </ul>
          </div>

          {/* Kolom buletin, dan hanya bila situs ini menyatakannya (ADR-0049).
              Di footer, bukan di badan artikel: ia ada di setiap halaman tanpa
              pernah menyela apa yang sedang dibaca seseorang, dan tanpa
              menuntut satu keputusan tata letak per jenis halaman. Komponennya
              sendiri yang tidak merender apa pun saat `newsletterAktif` mati,
              jadi situs yang tidak memakainya tidak membayar satu byte pun. */}
          <FormBuletin />

          {/* Navigasi sekunder dari CMS (`awcms` #597 butir 6). Kolom ini hanya
              muncul bila tenant menyusun menu ber-key `footer`, dan labelnya
              datang APA ADANYA dari CMS — tidak lewat katalog PO, karena tidak
              ada terjemahan untuk teks yang baru ditulis editor lima menit
              lalu. Itu batasan yang dicatat ADR-0105 di `awcms`, bukan
              kelalaian: judul kolomnya tetap string antarmuka yang
              diterjemahkan, isinya yang tidak. */}
          {hasilMenu && hasilMenu.tautan.length > 0 && (
            <div>
              <h4 class="footer-judul">{menuFooter!.name}</h4>
              <ul class="footer-daftar">
                {hasilMenu.tautan.map((tautan) => (
                  <li>
                    <a href={tautan.href}>{tautan.label}</a>
                    {tautan.anak.length > 0 && (
                      <ul class="footer-daftar footer-daftar--anak">
                        {tautan.anak.map((anak) => (
                          <li><a href={anak.href}>{anak.label}</a></li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {widgetFooter.length > 0 &&
            widgetFooter.map((widget) => (
              <div>
                <h4 class="footer-judul">{widget.title}</h4>
                {widget.bodyText && <p class="footer-teks">{widget.bodyText}</p>}
              </div>
            ))}

          {/* Dua kolom yang HANYA muncul bila tenant mengisinya (`awcms` #596).
              Sebelum ini alamat redaksi dan kontak tidak punya tempat sama
              sekali — bukan kosong, tidak ada — sehingga satu-satunya cara
              menerbitkannya adalah menuliskannya ke dalam template ini, di
              situs yang bukan pemiliknya. Judul kolomnya tetap string
              antarmuka: yang datang dari tenant adalah ISINYA, bukan bahasa
              situsnya. */}
          {adaKontak(profil) && (
            <div>
              <h4 class="footer-judul">{t(locale, 'footer.contact.title')}</h4>
              <ul class="footer-daftar footer-kontak">
                {profil.editorialAddress && (
                  <li>
                    <span class="footer-kontak-label">{t(locale, 'footer.contact.address')}</span>
                    <address class="footer-alamat">{profil.editorialAddress}</address>
                  </li>
                )}
                {profil.contactEmail && (
                  <li><a href={`mailto:${profil.contactEmail}`}>{profil.contactEmail}</a></li>
                )}
                {profil.contactPhone && tautanTelepon(profil.contactPhone) && (
                  <li><a href={tautanTelepon(profil.contactPhone)!}>{profil.contactPhone}</a></li>
                )}
                {profil.whatsappNumber && tautanWhatsapp(profil.whatsappNumber) && (
                  <li>
                    {/* `rel="noopener"` karena ia keluar dari situs ini; tanpa
                        `target="_blank"` supaya pembaca tidak kehilangan
                        halamannya sendiri. */}
                    <a href={tautanWhatsapp(profil.whatsappNumber)!} rel="noopener nofollow">
                      {t(locale, 'footer.contact.whatsapp')}
                    </a>
                  </li>
                )}
              </ul>
            </div>
          )}

          {profil.socialLinks.length > 0 && (
            <div>
              <h4 class="footer-judul">{t(locale, 'footer.social.title')}</h4>
              <ul class="footer-daftar">
                {profil.socialLinks.map((tautan) => (
                  <li>
                    {/* `nofollow` karena ini profil, bukan rekomendasi; URL-nya
                        sudah ditolak-bukan-disanitasi kecuali http(s) absolut,
                        dua kali: saat ditulis di `awcms` dan lagi saat dibaca
                        di `lib/awcms/profil.ts`. */}
                    <a href={tautan.url} rel="noopener nofollow">{tautan.platform}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <DisclaimerNote variant="footer" />
      </div>

      {/* Pita penutup melintasi seluruh lebar, jadi ia berdiri DI LUAR
          `.container` dan menaruh containernya sendiri di dalam. Sebelumnya
          garis atasnya berhenti di batas container, yang membuat footer tampak
          seperti dua kotak bertumpuk alih-alih satu blok dengan penutup. */}
      <div class="footer-bawah">
        <div class="container">
          {/* Tahun mulai tidak ditulis di sini: `2023` adalah tahun repo
              rujukan berdiri, dan situs mana pun yang lahir dari template ini
              akan mengklaim tahun itu sebagai tahunnya sendiri. Tahunnya
              dibekukan saat build — situs ini dibangun ulang setidaknya sekali
              sehari (lihat .github/workflows/rebuild.yml), jadi ia tidak
              tertinggal. */}
          {barisCopyright(profil, locale, new Date().getFullYear())}
        </div>
      </div>
    </footer>

    {/* Satu kunjungan halaman, tanpa kredensial (ADR-0044). Terakhir di
        `<body>` karena ia tidak punya apa pun untuk digambar dan tidak boleh
        mendahului satu piksel pun; komponennya sendiri yang memutuskan apakah
        ia memancarkan sesuatu sama sekali. */}
    <BeaconKunjungan />
  </body>
</html>

