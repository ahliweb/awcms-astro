    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--gelap-teks-redup);
  }

  /* `<address>` dimiringkan peramban secara bawaan, dan alamat redaksi bukan
     kutipan. */
  .footer-alamat {
    font-style: normal;
    font-size: 0.875rem;
    color: var(--gelap-teks-redup);
    white-space: pre-line;
  }

  /* Pita penutup: garisnya melintasi seluruh lebar footer, jadi ia berdiri di
     luar `.container` dan menaruh padding-nya sendiri di dalam. */
  .footer-bawah {
    margin-top: 2.5rem;
    border-top: 1px solid var(--gelap-garis);
    padding: 1.35rem 0;
    text-align: center;
    font-size: 0.8rem;
    color: var(--gelap-teks-redup);
  }
</style>
