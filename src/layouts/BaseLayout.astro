    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--gelap-teks);
  }

  .widget-baris {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 0.75rem 0;
  }

  .widget-judul {
    font-size: 0.95rem;
    margin: 0 0 0.2rem;
  }

  .widget-teks {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .footer-daftar--anak {
    margin-left: 0.9rem;
  }

  .footer-teks {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--gelap-teks-redup);
    max-width: 22rem;
  }

  .footer-daftar {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.9rem;
  }

  /* Kolom kontak (`awcms` #596). Sedikit lebih longgar dari daftar tautan
     biasa karena alamat redaksi membungkus jadi beberapa baris. */
  .footer-kontak {
    gap: 0.6rem;
  }

  .footer-kontak-label {
    display: block;
