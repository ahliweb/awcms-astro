---
import TabNav from '../components/TabNav.astro';
import DisclaimerNote from '../components/DisclaimerNote.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import ShareButtons from '../components/ShareButtons.astro';
import {
  siteConfig,
  getSiteUrl,
  getLocaleFromPath,
  localePath,
  swapLocalePath,
  localeHtmlLang,
  localeMeta,
  locales,
  defaultLocale,
  tabTitleKey,
  type Locale,
} from '../config/site';
import { t } from '../lib/po';
import { SITE_SOCIAL_IMAGE, SOCIAL_IMAGE_HEIGHT, SOCIAL_IMAGE_WIDTH } from '../lib/social-image';
import { siteSchema } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentTab?: string;
  /**
   * URL absolut kartu share. Wajib PNG — lihat `src/lib/social-image.ts`.
   * Kosong berarti halaman ini tidak memasang tag gambar sama sekali; itu
   * keadaan yang didukung dan merupakan bawaan template.
   */
  ogImage?: string;
  /** Teks alternatif kartu share; dibaca pembaca layar di lini masa sosial. */
  ogImageAlt?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  /** JSON-LD tambahan khas halaman ini (Article, ItemList, Place, …). */
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  /**
   * Metadata `article:*` Open Graph; hanya diisi halaman artikel.
   *
   * `tags` opsional: kontrak `AwcmsAstroBlock` belum membawa tag, jadi memaksa
   * pemanggil mengirim `[]` hanya menyamarkan ketiadaannya sebagai daftar
   * kosong yang disengaja.
   */
  articleMeta?: { modifiedTime: string; section: string; tags?: string[] };
  /** Menyembunyikan tombol bagikan; dipakai halaman yang tidak layak dibagikan. */
  hideShare?: boolean;
  /**
   * Halaman yang tidak boleh masuk indeks (404). Selain memasang `noindex`,
   * canonical dan hreflang ikut dilepas: halaman 404 Bahasa Indonesia disajikan
   * host sebagai `/404.html`, bukan `/404/`, sehingga alternate-nya akan
   * menunjuk URL yang tidak ada.
   */
  noindex?: boolean;
  /** Path yang dipakai pengalih bahasa bila path halaman ini bukan URL nyata. */
  langSwitchPath?: string;
}

const locale = getLocaleFromPath(Astro.url.pathname);
const pathname = Astro.url.pathname;

const {
  title,
  description = t(locale, 'home.description'),
  currentTab,
  ogImage = SITE_SOCIAL_IMAGE,
  ogImageAlt = t(locale, 'share.imageAlt'),
  canonicalUrl = getSiteUrl(pathname.endsWith('/') ? pathname : `${pathname}/`),
  ogType = 'website',
  schema,
  articleMeta,
  hideShare = false,
  noindex = false,
  langSwitchPath,
} = Astro.props;

// Nama situs datang dari konfigurasi, bukan dari kode. Versi sebelumnya
// menuliskan nama repo rujukan di sini secara harfiah, sehingga SETIAP judul
// halaman di SETIAP situs yang lahir dari template ini berakhiran nama situs
// orang lain — tanpa satu pun peringatan build.
const fullTitle = title.includes(siteConfig.name)
  ? title
  : `${title} — ${siteConfig.name}`;

const metaDescription = description.slice(0, 160);

// hreflang: setiap halaman punya pasangan di seluruh locale karena route
// dibangun berpasangan, jadi alternate selalu valid.
const alternates = locales.map((loc: Locale) => ({
  hreflang: localeHtmlLang[loc],
  href: getSiteUrl(swapLocalePath(pathname, loc)),
}));

// og:locale memakai bentuk `xx_YY`, dan sumbernya `htmlLang` di localeMeta —
// bukan daftar if/else. Sebuah locale baru cukup ditambahkan di satu tempat.
const ogLocale = localeMeta[locale].htmlLang.replace('-', '_');

// Satu blok JSON-LD per halaman: identitas situs selalu ada, skema khas halaman
// digabung di belakangnya. Crawler membaca @graph sebagai satu kesatuan.
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...siteSchema(locale, canonicalUrl), ...pageSchemas],
};
---

<!DOCTYPE html>
<html lang={localeHtmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    {!noindex && alternates.map((alt: { hreflang: string; href: string }) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {/* x-default menunjuk locale default repo ini, apa pun kodenya — bukan
        `'id'` yang dulu ditulis harfiah di sini. Situs yang mengubah
        `defaultLocale` tanpa menyentuh baris ini akan mengarahkan crawler ke
        bahasa yang bukan bahasa sumbernya. */}
    {!noindex && <link rel="alternate" hreflang="x-default" href={getSiteUrl(swapLocalePath(pathname, defaultLocale))} />}

    {/* Open Graph / Facebook.

        Tag gambar hanya dipasang bila kartunya benar-benar ada. Template ini
        tidak membawa pembangkit kartu, dan versi sebelumnya tetap memasang
        `og:image` ke `/social/<slug>.png` yang tidak pernah dibangkitkan
        siapa pun — pratinjau rusak di setiap halaman, dengan build hijau.
        Kartu share diisi lewat `SITE_SOCIAL_IMAGE`; lihat `.env.example`.

        Saat ada, ia wajib PNG dengan ukuran eksplisit: pengunduh pratinjau
        tidak menjalankan JavaScript dan tidak seragam mendukung SVG, dan tanpa
        width/height sebagian menunda render kartunya. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:secure_url" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(SOCIAL_IMAGE_WIDTH)} />
        <meta property="og:image:height" content={String(SOCIAL_IMAGE_HEIGHT)} />
        <meta property="og:image:alt" content={ogImageAlt} />
      </>
    )}
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={siteConfig.name} />
    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.modifiedTime} />
        <meta property="article:modified_time" content={articleMeta.modifiedTime} />
        <meta property="article:section" content={articleMeta.section} />
        {(articleMeta.tags ?? []).map((tag: string) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    {/* Twitter. `summary_large_image` menjanjikan gambar besar, jadi tanpa
        kartu yang nyata kartunya diturunkan ke `summary` alih-alih menjanjikan
        gambar yang tidak ada. */}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImage && (
      <>
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={ogImageAlt} />
      </>
    )}

    {/* JSON-LD adalah BLOK DATA, bukan skrip. Browser tidak pernah
        mengeksekusinya — tipe yang bukan MIME JavaScript membuat elemennya
        berhenti di "prepare the script element" sebelum langkah mana pun yang
        menjalankan kode — sehingga `script-src 'self'` tidak memblokir apa pun
        di sini. Ia sengaja TIDAK dipindah ke berkas eksternal: mesin pencari
        membaca JSON-LD dari halamannya, dan berkas terpisah adalah data yang
        tidak dibaca siapa pun. `tests/keluaran-csp.test.mjs` mengizinkan tepat
        tipe ini dan menolak skrip inline lainnya. */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Tema dipasang sebelum paint pertama agar tidak ada kedip (FOUC), jadi
        skrip ini klasik dan tidak ditunda — lihat `public/tema.js` untuk alasan
        ia berkas tersendiri alih-alih blok inline. Tanpa JavaScript atributnya
        tidak terpasang dan tema mengikuti prefers-color-scheme lewat media
        query di global.css. */}
    <script is:inline src="/tema.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(locale, 'ui.skipToMain')}</a>

    <header class="header-wrapper">
      <div class="container header-top">
        {/* Lambang dipisahkan dari nama supaya kedua barisnya rata kiri saat
            nama membungkus di layar sempit, dan lambangnya tetap di tengah
            secara vertikal terhadap blok nama — bukan menempel di baris
            pertama. aria-hidden karena ia hiasan: pembaca layar cukup
            mendengar nama situsnya.

            Isinya datang dari `SITE_MARK` dan kosong secara bawaan. Dulu di
            sini ada emoji mobil polisi dan lencana "Kalteng" yang ditulis
            harfiah — atribut sebuah instansi dan sebuah wilayah, terbawa dari
            repo rujukan, tampil di header setiap situs yang lahir dari
            template ini. */}
        <a href={localePath(locale, '/')} class="brand-logo">
          {siteConfig.mark && <span class="brand-mark" aria-hidden="true">{siteConfig.mark}</span>}
          <span class="brand-name">{siteConfig.name}</span>
        </a>
        <div class="header-actions">
          <div class="header-tagline">
            {t(locale, 'header.tagline')}
          </div>
          <LangSwitcher path={langSwitchPath} />
          <button
            type="button"
            class="chip theme-toggle-btn"
            data-theme-toggle
            aria-label={t(locale, 'ui.themeToggle')}
          >
            <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>
        </div>
      </div>
      <div class="container">
        <TabNav currentTab={currentTab} />
      </div>
    </header>

    <main class="container my-6" id="main-content">
      <slot />
      {!hideShare && <ShareButtons title={fullTitle} url={canonicalUrl} />}
    </main>

    <footer>
      <div class="container">
        <div class="footer-grid">
          <div>
            <h4 class="footer-judul footer-judul--utama">{t(locale, 'footer.about.title')}</h4>
            <p class="footer-teks">
              {t(locale, 'footer.about.body')}
            </p>
          </div>
          <div>
            <h4 class="footer-judul">{t(locale, 'footer.kanal.title')}</h4>
            <ul class="footer-daftar">
              {siteConfig.tabs.map((tab) => (
                <li>
                  <a href={localePath(locale, `/${tab.slug}/`)}>{t(locale, tabTitleKey(tab.slug), tab.label)}</a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h4 class="footer-judul">{t(locale, 'footer.more.title')}</h4>
            <ul class="footer-daftar">
              <li><a href={localePath(locale, '/sitemap/')}>{t(locale, 'footer.sitemap')}</a></li>
            </ul>
          </div>
        </div>

        <DisclaimerNote variant="footer" />

        <div class="footer-bawah">
          {/* Tahun mulai tidak ditulis di sini: `2023` adalah tahun repo
              rujukan berdiri, dan situs mana pun yang lahir dari template ini
              akan mengklaim tahun itu sebagai tahunnya sendiri. Tahunnya
              dibekukan saat build — situs ini dibangun ulang setidaknya sekali
              sehari (lihat .github/workflows/rebuild.yml), jadi ia tidak
              tertinggal. */}
          &copy; {new Date().getFullYear()} {siteConfig.name}. {t(locale, 'footer.copyright')}
        </div>
      </div>
    </footer>

  </body>
</html>

<style>
  .footer-judul {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .footer-judul--utama {
    font-size: 1.1rem;
  }

  .footer-teks {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .footer-daftar {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-bawah {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
