---
/**
 * Tombol bagikan, ditambah salin tautan.
 *
 * Seluruhnya tautan `GET` biasa — tidak ada SDK, widget, piksel, atau skrip
 * pihak ketiga. Selain menjaga halaman tetap ringan, ini menutup jalur
 * pelacakan pembaca yang dilarang standar kepatuhan repo: tidak ada satu byte
 * pun yang dikirim ke penyedia sosial sampai pembaca sendiri mengekliknya.
 *
 * Tanpa JavaScript seluruh tautan tetap berfungsi; hanya tombol salin tautan
 * yang butuh JS, dan tombol itu disembunyikan bila JS tidak aktif.
 */
import { getLocaleFromPath } from '../config/site';
import { t } from '../lib/po';

interface Props {
  /** Judul yang ikut dibagikan; default judul halaman. */
  title: string;
  /** URL absolut halaman ini. */
  url: string;
}

const { title, url } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const targets = [
  {
    key: 'whatsapp',
    label: t(locale, 'share.whatsapp'),
    href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
  },
  {
    key: 'facebook',
    label: t(locale, 'share.facebook'),
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  },
  {
    key: 'x',
    label: t(locale, 'share.x'),
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
  },
  {
    key: 'telegram',
    label: t(locale, 'share.telegram'),
    href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
  },
];
---

<section class="share-box" aria-labelledby="share-heading">
  <h2 id="share-heading" class="share-title">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
    {t(locale, 'share.title')}
  </h2>
  <p class="share-lead">{t(locale, 'share.lead')}</p>

  <ul class="share-list">
    {targets.map((target) => (
      <li>
        <a
          class={`share-btn share-${target.key}`}
          href={target.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={target.label}
        >
          {target.key === 'whatsapp' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"></path><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38c1.45.79 3.08 1.21 4.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.83 9.83 0 0 0 12.04 2Zm0 18.13h-.01c-1.5 0-2.97-.4-4.25-1.16l-.3-.18-3.16.83.84-3.08-.2-.32a8.2 8.2 0 0 1-1.26-4.37c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.25 8.23Z"></path></svg>
          )}
          {target.key === 'facebook' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.44 2.91h-2.34v7.03C18.34 21.24 22 17.08 22 12.06Z"></path></svg>
          )}
          {target.key === 'x' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.66l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.01 4.13H5.05l12.03 15.64Z"></path></svg>
          )}
          {target.key === 'telegram' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.94 4.3 18.9 19.1c-.23 1.02-.84 1.27-1.7.79l-4.7-3.46-2.27 2.18c-.25.25-.46.46-.94.46l.33-4.78 8.7-7.86c.38-.34-.08-.53-.59-.19L6.98 13.02l-4.63-1.45c-1.01-.31-1.03-1 .21-1.48l18.1-6.98c.84-.31 1.57.19 1.28 1.19Z"></path></svg>
          )}
          <span>{target.label}</span>
        </a>
      </li>
    ))}
    <li class="share-copy-item">
      <button type="button" class="share-btn share-copy" data-share-copy data-url={url} data-copied={t(locale, 'share.copied')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span data-share-copy-label>{t(locale, 'share.copy')}</span>
      </button>
    </li>
  </ul>
  <p class="share-status" role="status" aria-live="polite" data-share-status></p>
</section>

<script>
  // Tombol salin butuh JavaScript, jadi baru ditampilkan setelah skrip jalan.
  // Tanpa ini pengguna tanpa JS melihat tombol yang diam saat diklik.
  document.querySelectorAll<HTMLElement>('.share-copy-item').forEach((item) => {
    item.hidden = !navigator.clipboard;
  });

  document.querySelectorAll<HTMLButtonElement>('[data-share-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const url = button.dataset.url;
      const status = button.closest('.share-box')?.querySelector<HTMLElement>('[data-share-status]');
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        if (status) status.textContent = button.dataset.copied ?? '';
        window.setTimeout(() => {
          if (status) status.textContent = '';
        }, 4000);
      } catch {
        /* Clipboard ditolak browser: tautan tetap terlihat di bilah alamat. */
      }
    });
  });
</script>
