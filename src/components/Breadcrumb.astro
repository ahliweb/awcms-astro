---
import { getLocaleFromPath, localePath, getSiteUrl } from '../config/site';
import { t } from '../lib/po';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);

const fullItems = [
  { name: t(locale, 'breadcrumb.home'), url: localePath(locale, '/') },
  ...items
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": fullItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url.startsWith('http') ? item.url : getSiteUrl(item.url)
  }))
};
---

<nav aria-label={t(locale, 'breadcrumb.aria')} class="my-4">
  <ol class="remah-daftar">
    {fullItems.map((item, idx) => (
      <li>
        {idx > 0 && <span aria-hidden="true" class="remah-pemisah">›</span>}
        {idx === fullItems.length - 1 ? (
          <span class="remah-aktif" aria-current="page">{item.name}</span>
        ) : (
          <a href={item.url} class="remah-tautan">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<style>
  /* `padding-left` sengaja TIDAK di-reset: aturan inline sebelumnya juga tidak,
     jadi indentasi bawaan <ol> adalah tampilan yang sudah berjalan. */
  .remah-daftar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .remah-daftar li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .remah-pemisah {
    color: var(--text-muted);
  }

  .remah-aktif {
    color: var(--text-primary);
    font-weight: 600;
  }

  .remah-tautan {
    color: var(--text-secondary);
    text-decoration: none;
  }
</style>
