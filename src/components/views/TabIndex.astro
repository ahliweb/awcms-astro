---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import DisclaimerNote from '../DisclaimerNote.astro';
import { getLocaleFromPath, getSiteUrl, localePath, siteConfig, tabTitleKey, type TabSlug } from '../../config/site';
import { getArticles } from '../../lib/content';
import { getArticleImage, getTabImage } from '../../lib/article-images';
import { collectionSchema } from '../../lib/schema';
import { t } from '../../lib/po';

interface Props {
  tab: TabSlug;
}

const { tab } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);

const articles = await getArticles(tab, locale);

// Label breadcrumb datang dari katalog, bukan dari `tab.toUpperCase()`. Yang
// terakhir itu tidak pernah diterjemahkan dan menyalahi kapitalisasi bahasa
// mana pun yang ejaannya tidak sekadar huruf besar.
const tabFallback = siteConfig.tabs.find((entry) => entry.slug === tab)?.label ?? tab;
const tabLabel = t(locale, tabTitleKey(tab), tabFallback);
const title = t(locale, `tab.${tab}.pageTitle`, tabFallback);
const description = t(locale, `tab.${tab}.metaDesc`, '');

const breadcrumbItems = [
  { name: tabLabel, url: localePath(locale, `/${tab}/`) }
];

const schema = collectionSchema(
  t(locale, `tab.${tab}.h1`, tabLabel),
  description,
  articles.map(({ entry, slug }) => ({
    name: entry.data.title,
    url: localePath(locale, `/${tab}/${slug}/`),
  }))
);
---

<BaseLayout
  title={title}
  description={description}
  currentTab={tab}
  canonicalUrl={getSiteUrl(localePath(locale, `/${tab}/`))}
  ogImageAlt={getTabImage(tab).alt}
  schema={schema}
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="feature-hero">
    <div>
      <h1>{t(locale, `tab.${tab}.h1`, tabLabel)}</h1>
      <p class="artikel-lead">
        {t(locale, `tab.${tab}.lead`, '')}
      </p>
    </div>
    <div class="feature-hero-img">
      <div class="visual-placeholder visual-hero" role="img" aria-label={getTabImage(tab).alt}></div>
    </div>
  </section>

  <div class="grid-cards">
    {articles.map(({ entry, slug }) => {
      const imgInfo = getArticleImage(tab, slug);
      return (
        <a href={localePath(locale, `/${tab}/${slug}/`)} class="card">
          <div class="card-img-wrapper">
            <div class="visual-placeholder" role="img" aria-label={imgInfo.alt}></div>
          </div>
          <div class="card-content">
            <div class="kartu-baris-atas">
              <span class="kartu-nomor">
                {t(locale, 'tab.articleNo')}{entry.data.urutan}
              </span>
            </div>
            <h3 class="card-title">{entry.data.title}</h3>
            <p class="card-desc">{entry.data.description}</p>
            <div class="card-meta teks-aksen">
              <span>{t(locale, 'tab.readMoreCta')}</span>
            </div>
          </div>
        </a>
      );
    })}
  </div>

  <DisclaimerNote variant="general" />
</BaseLayout>

<style>
  .kartu-nomor {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
