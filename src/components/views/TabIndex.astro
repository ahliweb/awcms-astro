---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import DisclaimerNote from '../DisclaimerNote.astro';
import Ilustrasi from '../Ilustrasi.astro';
import { artikelPerHalaman, getLocaleFromPath, getSiteUrl, localePath, siteConfig, tabTitleKey, urutanSeksiTab, type TabSlug } from '../../config/site';
import { jalurHalaman, potongHalaman } from '../../lib/paginasi';
import { tanggalPanjang, tanggalMesin } from '../../lib/tanggal';
import { getArticles } from '../../lib/content';
import { getArticleVisual, getTabImage } from '../../lib/article-images';
import { collectionSchema } from '../../lib/schema';
import { seksiPunyaFeed } from '../../lib/feed';
import { jalurFeed } from '../../lib/feed-seksi';
import { profilSitus } from '../../lib/awcms/profil';
import { namaSitus } from '../../lib/identitas';
import { t } from '../../lib/po';

interface Props {
  tab: TabSlug;
  /**
   * 1-based. Page 1 is the section's own path and is what every existing route
   * renders by omitting this — see `lib/paginasi.ts` for why the `/halaman/1/`
   * twin is never generated.
   */
  nomor?: number;
}

const { tab, nomor = 1 } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);

const semuaArtikel = await getArticles(tab, locale);
const halaman = potongHalaman(semuaArtikel, nomor, artikelPerHalaman);
const articles = halaman.butir;

// Seksi berita menampilkan TANGGAL pada kartunya; seksi manual menampilkan
// nomor urut redaksi. Keduanya membaca hal yang sama: field yang menentukan
// urutan seksi itu. Sebuah kartu berita bernomor "Artikel 99" — nilai bawaan
// `urutan` untuk artikel yang tidak pernah dinomori — adalah label yang tidak
// berarti apa-apa di seksi yang tidak pernah dinomori siapa pun.
const seksiBerita = urutanSeksiTab(tab) === 'terbaru';

// Label breadcrumb datang dari katalog, bukan dari `tab.toUpperCase()`. Yang
// terakhir itu tidak pernah diterjemahkan dan menyalahi kapitalisasi bahasa
// mana pun yang ejaannya tidak sekadar huruf besar.
const tabFallback = siteConfig.tabs.find((entry) => entry.slug === tab)?.label ?? tab;
const tabLabel = t(locale, tabTitleKey(tab), tabFallback);
const judulSeksi = t(locale, `tab.${tab}.pageTitle`, tabFallback);

// Halaman 2..N membawa nomornya di `<title>`. Judul yang identik di seluruh
// halaman arsip adalah duplikat bagi perayap DAN bagi pembaca yang punya lima
// tab terbuka — dan ia satu-satunya pembeda yang terbawa ke hasil pencarian.
const title =
  halaman.nomor > 1
    ? `${judulSeksi} — ${t(locale, 'paginasi.halaman')} ${halaman.nomor}`
    : judulSeksi;
const description = t(locale, `tab.${tab}.metaDesc`, '');

const breadcrumbItems = [
  { name: tabLabel, url: localePath(locale, `/${tab}/`) }
];

// `alt` diambil alih dari katalog PO, bukan dipakai apa adanya dari
// `getTabImage`: yang terakhir memanusiawikan SLUG, sehingga pembaca dengan
// screen reader mendengar nama seksi versi URL alih-alih versi bahasanya — dan
// di locale berprefiks ia bahkan bukan bahasa yang sedang dibaca.
const tabVisual = { ...getTabImage(tab), alt: tabLabel };

// Tautan penemuan-otomatis feed, atau `undefined` (ADR-0035). Kedua syaratnya
// dibaca dari keadaan halaman ini apa adanya — seksi yang diurutkan tanggal DAN
// benar-benar berisi artikel — sehingga sebuah halaman tidak akan pernah
// mengumumkan feed yang rutenya tidak menerbitkan berkasnya.
// `semuaArtikel`, not `articles`: a section HAS a feed because the section has
// articles, not because this particular page does. Reading the page would make
// the announcement disappear from page 2 of a section that publishes one.
const feed = seksiPunyaFeed(urutanSeksiTab(tab), semuaArtikel.length)
  ? { judul: `${tabLabel} — ${namaSitus(await profilSitus())}`, href: jalurFeed(locale, tab) }
  : undefined;

const schema = collectionSchema(
  t(locale, `tab.${tab}.h1`, tabLabel),
  description,
  articles.map(({ entry, slug }) => ({
    name: entry.data.title,
    url: localePath(locale, `/${tab}/${slug}/`),
  }))
);
---

<BaseLayout
  title={title}
  description={description}
  currentTab={tab}
  canonicalUrl={getSiteUrl(jalurHalaman(locale, tab, halaman.nomor))}
  schema={schema}
  feed={feed}
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="feature-hero">
    <div>
      <h1>{t(locale, `tab.${tab}.h1`, tabLabel)}</h1>
      <p class="artikel-lead">
        {t(locale, `tab.${tab}.lead`, '')}
      </p>
    </div>
    <div class="feature-hero-img">
      <Ilustrasi src={tabVisual.src} alt={tabVisual.alt} hero />
    </div>
  </section>

  <div class="grid-cards">
    {articles.map((article) => {
      const { entry, slug } = article;
      const imgInfo = getArticleVisual(article, tab, slug);
      return (
        <a href={localePath(locale, `/${tab}/${slug}/`)} class="card">
          <div class="card-img-wrapper">
            <Ilustrasi
              src={imgInfo.src}
              alt={imgInfo.alt}
              width={imgInfo.width}
              height={imgInfo.height}
            />
          </div>
          <div class="card-content">
            <div class="kartu-baris-atas">
              {seksiBerita ? (
                <time class="kartu-nomor" datetime={tanggalMesin(entry.data.publishedDate)}>
                  {tanggalPanjang(locale, entry.data.publishedDate)}
                </time>
              ) : (
                <span class="kartu-nomor">
                  {t(locale, 'tab.articleNo')}{entry.data.urutan}
                </span>
              )}
            </div>
            <h3 class="card-title">{entry.data.title}</h3>
            <p class="card-desc">{entry.data.description}</p>
            <div class="card-meta teks-aksen">
              <span>{t(locale, 'tab.readMoreCta')}</span>
            </div>
          </div>
        </a>
      );
    })}
  </div>

  {halaman.total > 1 && (
    <nav class="paginasi" aria-label={t(locale, 'paginasi.aria')}>
      {/* Tautan sebenarnya, bukan tombol ber-JavaScript: seluruh situs ini
          harus terbaca dengan JavaScript dimatikan, dan sebuah arsip yang
          hanya bisa ditelusuri oleh skrip adalah arsip yang tidak bisa
          ditelusuri perayap juga. */}
      {halaman.sebelumnya !== null ? (
        <a class="paginasi-tautan" rel="prev" href={jalurHalaman(locale, tab, halaman.sebelumnya)}>
          {t(locale, 'paginasi.sebelumnya')}
        </a>
      ) : (
        <span class="paginasi-tautan paginasi-mati" aria-hidden="true">{t(locale, 'paginasi.sebelumnya')}</span>
      )}

      <span class="paginasi-posisi">
        {t(locale, 'paginasi.halaman')} {halaman.nomor} / {halaman.total}
      </span>

      {halaman.berikutnya !== null ? (
        <a class="paginasi-tautan" rel="next" href={jalurHalaman(locale, tab, halaman.berikutnya)}>
          {t(locale, 'paginasi.berikutnya')}
        </a>
      ) : (
        <span class="paginasi-tautan paginasi-mati" aria-hidden="true">{t(locale, 'paginasi.berikutnya')}</span>
      )}
    </nav>
  )}

  <DisclaimerNote variant="general" />
</BaseLayout>

<style>
  .kartu-nomor {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .paginasi {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 2rem 0;
    flex-wrap: wrap;
  }

  .paginasi-tautan {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--border-color, currentColor);
    border-radius: 0.4rem;
    text-decoration: none;
    /* Target sentuh ≥44px (AGENTS.md §Antarmuka). */
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  /* Ujung arsip ditampilkan sebagai teks mati, bukan disembunyikan: posisi
     kedua tombol tetap sama di setiap halaman, sehingga penunjuk pembaca tidak
     berpindah tempat saat ia sampai di ujung. */
  .paginasi-mati {
    opacity: 0.45;
  }

  .paginasi-posisi {
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>
