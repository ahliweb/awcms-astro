---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisclaimerNote from '../DisclaimerNote.astro';
import Ilustrasi from '../Ilustrasi.astro';
import { siteConfig, getLocaleFromPath, localePath, tabTitleKey } from '../../config/site';
import { getArticles } from '../../lib/content';
import { getTabImage, heroImage } from '../../lib/article-images';
import { collectionSchema } from '../../lib/schema';
import { t } from '../../lib/po';

const locale = getLocaleFromPath(Astro.url.pathname);

const counts: Record<string, number> = {};
for (const tab of siteConfig.tabs) {
  counts[tab.slug] = (await getArticles(tab.slug, locale)).length;
}

const schema = collectionSchema(
  t(locale, 'home.sectionTitle'),
  t(locale, 'home.sectionLead'),
  siteConfig.tabs.map((tab) => ({
    name: t(locale, tabTitleKey(tab.slug), tab.label),
    url: localePath(locale, `/${tab.slug}/`),
  }))
);
---

<BaseLayout
  title={t(locale, 'home.title')}
  description={t(locale, 'home.description')}
  schema={schema}
>
  <section class="hero-banner-grid">
    <div class="hero-banner-content">
      <span class="badge badge--emerald mb-4">
        {t(locale, 'home.badge')}
      </span>
      <h1>
        {t(locale, 'home.h1')}
      </h1>
      <p>
        {t(locale, 'home.lead')}
      </p>
      <div class="baris-aksi">
        {/* Panah dan pin adalah hiasan: dipisahkan dari teks katalog supaya
            penerjemah tidak perlu ikut memindahkannya, dan supaya pembaca
            layar tidak melafalkan "round pushpin" di ujung kalimat. */}
        <a href="#kanal-layanan" class="chip chip--ajakan">
          {t(locale, 'home.ctaKanal')}
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    <div class="hero-visual-frame animate-float">
      {/* `alt` dari katalog PO, bukan dari `heroImage.alt` yang sengaja kosong:
          beranda satu-satunya tempat yang punya string terjemahannya. */}
      <Ilustrasi src={heroImage.src} alt={t(locale, 'home.heroAlt')} hero />
    </div>
  </section>

  <section class="my-6" id="kanal-layanan">
    <h2>{t(locale, 'home.sectionTitle')}</h2>
    <p class="seksi-lead">
      {t(locale, 'home.sectionLead')}
    </p>

    <div class="grid-cards">
      {siteConfig.tabs.map((tab) => (
        <a href={localePath(locale, `/${tab.slug}/`)} class="card kartu-tanpa-garis">
          <div class="card-img-wrapper">
            <Ilustrasi
              src={getTabImage(tab.slug).src}
              alt={t(locale, tabTitleKey(tab.slug), tab.label)}
            />
          </div>
          <div class="card-content">
            <div class="kartu-baris-atas kartu-baris-atas--puncak">
              <h3 class="card-title kartu-judul-rapat">{t(locale, tabTitleKey(tab.slug), tab.label)}</h3>
              <span class="badge badge--aksen">
                {counts[tab.slug]} {t(locale, 'home.articleCount')}
              </span>
            </div>
            <p class="card-desc">{t(locale, `home.tab.${tab.slug}.desc`, '')}</p>
            <div class="card-meta teks-aksen">
              {/* Dulu `{t('home.cta')} {tab.name}` — "Mulai dari panduan"
                  disambung nama tab HURUF BESAR, jadi kartu Panduan berbunyi
                  "Mulai dari panduan PANDUAN". Sekarang satu ajakan, satu
                  nama tab, keduanya dari katalog. */}
              <span>{t(locale, 'home.cta')} {t(locale, tabTitleKey(tab.slug), tab.label)}</span>
              <span aria-hidden="true">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="my-6 panel panel--besar">
    <h2>{t(locale, 'home.principles.title')}</h2>
    <ul class="daftar-prinsip">
      <li><strong>{t(locale, 'home.principles.1.label')}</strong> {t(locale, 'home.principles.1.body')}</li>
      <li><strong>{t(locale, 'home.principles.2.label')}</strong> {t(locale, 'home.principles.2.body')}</li>
      <li><strong>{t(locale, 'home.principles.3.label')}</strong> {t(locale, 'home.principles.3.body')}</li>
    </ul>
  </section>

  <DisclaimerNote variant="general" />
</BaseLayout>

<style>
  .badge--emerald {
    background: var(--emerald-primary);
    color: #ffffff;
  }

  .badge--aksen {
    background: var(--accent-subtle);
    color: var(--accent-primary);
  }

  .baris-aksi {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .chip--ajakan {
    background: var(--emerald-primary);
    color: #ffffff;
    border: none;
    padding: 0.6rem 1.25rem;
    font-size: 0.95rem;
  }

  .seksi-lead {
    color: var(--text-muted);
  }

  .kartu-tanpa-garis {
    text-decoration: none;
  }

  .kartu-judul-rapat {
    margin: 0;
  }

  .daftar-prinsip {
    padding-left: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }
</style>
