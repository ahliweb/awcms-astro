---
/**
 * Beranda.
 *
 * ## Apa yang berubah pada redesign, dan kenapa
 *
 * Versi sebelumnya menampilkan tiga hal: hero, kartu kanal, prinsip penyusunan.
 * Tidak satu pun dari ketiganya adalah ISI situs — seorang pembaca yang mendarat
 * di beranda tidak bisa melihat satu judul artikel pun sebelum ia menebak kanal
 * mana yang harus dibuka. Redesign ini menambahkan dua permukaan yang membawa
 * isi sungguhan, dan keduanya diturunkan dari data yang sudah dibaca build ini:
 *
 *   - **Panel "terbaru"** di dalam hero — tiga artikel terbaru lintas kanal.
 *   - **Sorotan** — artikel PALING baru, dengan gambarnya sendiri.
 *
 * Keduanya membaca satu daftar yang sama dan tidak pernah menampilkan artikel
 * yang sama dua kali: sorotan mengambil yang pertama, panel mengambil tiga
 * berikutnya. Duplikasi itu bukan kemungkinan teoretis — rancangannya sendiri
 * memuat judul yang sama di kedua tempat.
 *
 * ## Angka pada pita statistik hanya yang bisa dihitung build ini
 *
 * Rancangan yang dikerjakan ulang di sini memuat empat angka; yang keempat
 * adalah "Skor Lighthouse 100". Ia TIDAK ikut. Tidak ada apa pun di build ini
 * yang mengukurnya, jadi angka itu akan menjadi klaim yang dicetak setiap
 * halaman dan diperiksa tidak seorang pun — persis kelas cacat yang membuat repo
 * ini menolak `og:image` ke kartu yang tak pernah dibangkitkan. Ketiga angka
 * yang tersisa dihitung dari feed yang sama yang membangun halaman ini.
 *
 * ## Urutan panel "terbaru" punya pemutus seri
 *
 * Dua artikel yang terbit pada detik yang sama akan bertukar tempat antar-build
 * bila urutannya hanya tanggal — keluaran statis yang berbeda tanpa ada yang
 * berubah. Slug memutuskannya, dan slug unik per kanal.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisclaimerNote from '../DisclaimerNote.astro';
import Ilustrasi from '../Ilustrasi.astro';
import {
  siteConfig,
  getLocaleFromPath,
  localePath,
  localeMeta,
  locales,
  tabTitleKey,
  type Locale,
} from '../../config/site';
import { getArticles, type LocalizedArticle } from '../../lib/content';
import { getArticleVisual, getTabImage, heroImage } from '../../lib/article-images';
import { collectionSchema } from '../../lib/schema';
import { pernahDiubahSetelahTerbit, tanggalMesin, tanggalPanjang } from '../../lib/tanggal';
import { t } from '../../lib/po';

const locale = getLocaleFromPath(Astro.url.pathname);

/** Satu artikel beserta kanal tempat ia berdiri — kanal tidak ada di artikelnya. */
type ArtikelBerkanal = {
  tab: (typeof siteConfig.tabs)[number];
  artikel: LocalizedArticle;
};

const counts: Record<string, number> = {};
const semuaArtikel: ArtikelBerkanal[] = [];

for (const tab of siteConfig.tabs) {
  const artikel = await getArticles(tab.slug, locale);
  counts[tab.slug] = artikel.length;
  for (const satu of artikel) semuaArtikel.push({ tab, artikel: satu });
}

// Terbaru lebih dulu. Slug adalah pemutus seri — lihat catatan di atas.
const menurutTerbaru = [...semuaArtikel].sort((a, b) => {
  const selisih =
    b.artikel.entry.data.publishedDate.getTime() -
    a.artikel.entry.data.publishedDate.getTime();
  return selisih !== 0 ? selisih : a.artikel.slug.localeCompare(b.artikel.slug);
});

const sorotan = menurutTerbaru[0];
const panelTerbaru = menurutTerbaru.slice(1, 4);

const totalArtikel = semuaArtikel.length;

/**
 * Tanggal tinjauan TERAKHIR di seluruh situs, atau tidak sama sekali.
 *
 * `updatedDate`, bukan `publishedDate`: yang dijanjikan labelnya adalah kapan
 * isi situs ini terakhir disentuh, dan sebuah koreksi pada artikel lama adalah
 * sentuhan yang paling layak dilaporkan (ADR-0033 memisahkan keduanya justru
 * supaya pertanyaan ini punya jawaban sendiri).
 */
const terakhirDitinjau = semuaArtikel.reduce<Date | undefined>((paling, { artikel }) => {
  const nilai = artikel.entry.data.updatedDate;
  return paling === undefined || nilai.getTime() > paling.getTime() ? nilai : paling;
}, undefined);

/** Nama setiap bahasa situs ini, dirangkai dari konfigurasi alih-alih ditulis. */
const daftarBahasa = locales.map((loc: Locale) => localeMeta[loc].nama).join(' · ');

function jalurArtikel(butir: ArtikelBerkanal): string {
  return localePath(locale, `/${butir.tab.slug}/${butir.artikel.slug}/`);
}

function namaKanal(butir: ArtikelBerkanal): string {
  return t(locale, tabTitleKey(butir.tab.slug), butir.tab.label);
}

const schema = collectionSchema(
  t(locale, 'home.sectionTitle'),
  t(locale, 'home.sectionLead'),
  siteConfig.tabs.map((tab) => ({
    name: t(locale, tabTitleKey(tab.slug), tab.label),
    url: localePath(locale, `/${tab.slug}/`),
  }))
);

const sorotanVisual = sorotan
  ? getArticleVisual(sorotan.artikel, sorotan.tab.slug, sorotan.artikel.slug)
  : undefined;
---

<BaseLayout
  title={t(locale, 'home.title')}
  description={t(locale, 'home.description')}
  schema={schema}
>
  <section class="hero-banner-grid">
    <div class="hero-banner-content">
      <span class="badge badge--emerald mb-4">
        {t(locale, 'home.badge')}
      </span>
      <h1>
        {t(locale, 'home.h1')}
      </h1>
      <p>
        {t(locale, 'home.lead')}
      </p>
      <div class="baris-aksi">
        {/* Panah adalah hiasan: dipisahkan dari teks katalog supaya penerjemah
            tidak perlu ikut memindahkannya, dan supaya pembaca layar tidak
            melafalkan namanya di ujung kalimat. */}
        <a href="#kanal-layanan" class="chip chip--ajakan">
          {t(locale, 'home.ctaKanal')}
          <span aria-hidden="true">↓</span>
        </a>
        {/* Hanya bila ada yang baru untuk dibaca. Sebuah tombol yang melompat ke
            jangkar yang tidak dirender halaman ini tidak akan berbunyi rusak —
            ia hanya tidak melakukan apa pun, yang lebih buruk. */}
        {sorotan && (
          <a href="#sorotan" class="chip chip--ajakan-samar">
            {t(locale, 'home.ctaTerbaru')}
          </a>
        )}
      </div>
      <ul class="hero-jaminan">
        <li>{t(locale, 'home.trust.tanpaPelacak')}</li>
        <li>{t(locale, 'home.trust.tanpaJs')}</li>
        <li>{daftarBahasa}</li>
      </ul>
    </div>

    <div class="hero-panel">
      {/* Seni beranda, dan HANYA bila situs ini benar-benar punya — berbeda dari
          setiap bingkai lain di repo ini, yang merender `.visual-placeholder`
          saat seninya tidak ada.

          Alasannya adalah apa yang berdiri di bawahnya. Bingkai kosong di tempat
          lain menahan tata letak halaman yang tanpa gambar akan runtuh; di sini
          panelnya sudah berisi daftar artikel terbaru, jadi yang ditahan
          placeholder bukan tata letak melainkan perhatian — sebuah persegi
          bergaris selebar panel, di lipatan pertama, tepat di atas satu-satunya
          isi sungguhan yang dibawa beranda. Rancangan redesign ini memang tidak
          memuat gambar di sana sama sekali.

          `heroImage` TIDAK dihapus bersamanya: konvensi `src/assets/hero.svg`
          tetap berlaku, dan situs yang memasang berkasnya tetap melihatnya. Yang
          hilang hanya bingkai kosongnya. */}
      {heroImage.src && (
        <div class="hero-visual-frame">
          {/* `alt` dari katalog PO, bukan dari `heroImage.alt` yang sengaja
              kosong: beranda satu-satunya tempat yang punya string
              terjemahannya. */}
          <Ilustrasi src={heroImage.src} alt={t(locale, 'home.heroAlt')} hero />
        </div>
      )}

      {panelTerbaru.length > 0 && (
        <div class="panel-terbaru">
          <div class="panel-terbaru-kepala">
            <span class="panel-terbaru-judul">{t(locale, 'home.terbaru.judul')}</span>
            <a href={localePath(locale, '/sitemap/')} class="panel-terbaru-semua">
              {t(locale, 'home.terbaru.semua')}
              <span aria-hidden="true">→</span>
            </a>
          </div>
          <ul class="panel-terbaru-daftar">
            {panelTerbaru.map((butir) => (
              <li>
                <a href={jalurArtikel(butir)}>
                  <span class="panel-terbaru-meta">
                    <span class="panel-terbaru-kanal">{namaKanal(butir)}</span>
                    <time datetime={tanggalMesin(butir.artikel.entry.data.publishedDate)}>
                      {tanggalPanjang(locale, butir.artikel.entry.data.publishedDate)}
                    </time>
                  </span>
                  <span class="panel-terbaru-tajuk">{butir.artikel.entry.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  {/* Pita statistik. Ia hanya muncul pada situs yang PUNYA artikel: "0 artikel
      diterbitkan" dicetak besar-besar di lipatan pertama adalah pengumuman yang
      tidak dibutuhkan template kosong maupun pembacanya. */}
  {totalArtikel > 0 && (
    <div class="pita-statistik">
      <div class="statistik">
        <div class="statistik-nilai">{siteConfig.tabs.length}</div>
        <div class="statistik-label">{t(locale, 'home.statistik.kanal')}</div>
      </div>
      <div class="statistik">
        <div class="statistik-nilai">{totalArtikel}</div>
        <div class="statistik-label">{t(locale, 'home.statistik.artikel')}</div>
      </div>
      {terakhirDitinjau && (
        <div class="statistik">
          <time class="statistik-nilai statistik-nilai--tanggal" datetime={tanggalMesin(terakhirDitinjau)}>
            {tanggalPanjang(locale, terakhirDitinjau)}
          </time>
          <div class="statistik-label">{t(locale, 'home.statistik.diperbarui')}</div>
        </div>
      )}
    </div>
  )}

  <section class="my-6" id="kanal-layanan">
    <div class="seksi-kepala">
      <div>
        <h2>{t(locale, 'home.sectionTitle')}</h2>
        <p class="seksi-lead">
          {t(locale, 'home.sectionLead')}
        </p>
      </div>
      {/* Peta situs, bukan sebuah "arsip" yang tidak punya rute. Halaman itu
          sudah ada dan sudah mendaftar setiap kanal beserta artikelnya. */}
      <a href={localePath(locale, '/sitemap/')} class="seksi-tautan">
        {t(locale, 'home.arsip')}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid-cards">
      {siteConfig.tabs.map((tab) => (
        <a href={localePath(locale, `/${tab.slug}/`)} class="card kartu-tanpa-garis">
          <div class="card-img-wrapper">
            <Ilustrasi
              src={getTabImage(tab.slug).src}
              alt={t(locale, tabTitleKey(tab.slug), tab.label)}
            />
          </div>
          <div class="card-content">
            <div class="kartu-baris-atas kartu-baris-atas--puncak">
              <h3 class="card-title kartu-judul-rapat">{t(locale, tabTitleKey(tab.slug), tab.label)}</h3>
              <span class="badge badge--aksen">
                {counts[tab.slug]} {t(locale, 'home.articleCount')}
              </span>
            </div>
            <p class="card-desc">{t(locale, `home.tab.${tab.slug}.desc`, '')}</p>
            {/* Dulu `{t('home.cta')} {tab.name}` — "Mulai dari panduan"
                disambung nama tab HURUF BESAR, jadi kartu Panduan berbunyi
                "Mulai dari panduan PANDUAN". Sekarang satu ajakan, tanpa nama
                kanal: judul kanal berdiri tiga baris di atasnya. */}
            <div class="card-meta teks-aksen kartu-kaki">
              <span>{t(locale, 'home.cta')}</span>
              <span aria-hidden="true">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  {sorotan && sorotanVisual && (
    <section class="sorotan" id="sorotan">
      <div class="sorotan-visual">
        <Ilustrasi
          src={sorotanVisual.src}
          alt={sorotanVisual.alt}
          width={sorotanVisual.width}
          height={sorotanVisual.height}
        />
      </div>
      <div class="sorotan-isi">
        <div class="sorotan-baris-atas">
          <span class="badge badge--emerald">{t(locale, 'home.sorotan.badge')}</span>
          <span class="sorotan-jejak">
            {namaKanal(sorotan)}
            <span aria-hidden="true"> · </span>
            <time datetime={tanggalMesin(sorotan.artikel.entry.data.publishedDate)}>
              {tanggalPanjang(locale, sorotan.artikel.entry.data.publishedDate)}
            </time>
          </span>
        </div>
        <h2 class="sorotan-judul">{sorotan.artikel.entry.data.title}</h2>
        <p class="sorotan-ringkas">{sorotan.artikel.entry.data.description}</p>
        {/* Hanya bila artikelnya BENAR-BENAR pernah diubah setelah terbit —
            baris "diperbarui" yang selalu menampilkan tanggal terbit adalah
            klaim koreksi yang tidak pernah terjadi (ADR-0033). */}
        {pernahDiubahSetelahTerbit(
          sorotan.artikel.entry.data.publishedDate,
          sorotan.artikel.entry.data.updatedDate
        ) && (
          <p class="sorotan-diperbarui">
            {t(locale, 'home.sorotan.diperbarui')}{' '}
            <time datetime={tanggalMesin(sorotan.artikel.entry.data.updatedDate)}>
              {tanggalPanjang(locale, sorotan.artikel.entry.data.updatedDate)}
            </time>
          </p>
        )}
        <a href={jalurArtikel(sorotan)} class="chip chip--ajakan-pekat">
          {t(locale, 'home.sorotan.cta')}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )}

  <section class="my-6 panel panel--besar">
    <h2>{t(locale, 'home.principles.title')}</h2>
    <div class="prinsip-grid">
      <div class="prinsip-butir">
        <span class="prinsip-nomor" aria-hidden="true">01</span>
        <h3 class="prinsip-judul">{t(locale, 'home.principles.1.label')}</h3>
        <p class="prinsip-teks">{t(locale, 'home.principles.1.body')}</p>
      </div>
      <div class="prinsip-butir">
        <span class="prinsip-nomor" aria-hidden="true">02</span>
        <h3 class="prinsip-judul">{t(locale, 'home.principles.2.label')}</h3>
        <p class="prinsip-teks">{t(locale, 'home.principles.2.body')}</p>
      </div>
      <div class="prinsip-butir">
        <span class="prinsip-nomor" aria-hidden="true">03</span>
        <h3 class="prinsip-judul">{t(locale, 'home.principles.3.label')}</h3>
        <p class="prinsip-teks">{t(locale, 'home.principles.3.body')}</p>
      </div>
    </div>
  </section>

  <DisclaimerNote variant="general" />
</BaseLayout>

<style>
  /* ==========================================================================
     HERO BERANDA

     Ia tinggal di sini, bukan di `src/styles/global.css`, karena tidak ada
     halaman lain yang punya hero — dan berkas global dimuat oleh setiap halaman.
     `bun run audit:aset` yang membuktikannya berbiaya: dengan gaya ini di berkas
     global, halaman `/cari/` melewati plafon 36.000 B karena gaya sebuah elemen
     yang tidak pernah direndernya.

     Gradiennya bernilai tetap, bukan token, dan itu sudah begitu sejak versi
     pertama repo ini: ia gelap pada tema terang MAUPUN gelap. Yang ditambahkan
     redesign ini di atasnya adalah dua lapisan hiasan — kisi tipis dan satu rona
     melingkar — keduanya `::before`/`::after`, jadi tidak ada satu pun elemen
     tambahan di markup dan tidak ada satu byte JavaScript.

     `overflow: hidden` bukan kebetulan yang beruntung: ia yang memotong kedua
     lapisan itu mengikuti sudut membulat hero. Menghapusnya membuat rona
     melingkar menonjol keluar dan mendorong halaman menggulir mendatar.
     ========================================================================== */
  .hero-banner-grid {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: 3rem;
    align-items: center;
    background: linear-gradient(135deg, #090d16 0%, #0d1f30 48%, #062c3f 100%);
    color: var(--gelap-teks);
    padding: 3.75rem 3rem;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    margin-bottom: 2rem;
    animation: fadeInUp 0.7s ease-out;
  }

  /* Kisi tipis. `mask-image` memudarkannya sebelum ia mencapai tepi bawah, jadi
     ia tidak pernah bersaing dengan teks yang berdiri di atasnya. */
  .hero-banner-grid::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(120% 90% at 20% 0%, #000 20%, transparent 78%);
  }

  /* Rona melingkar di pojok kanan atas. */
  .hero-banner-grid::after {
    content: '';
    position: absolute;
    top: -180px;
    right: -120px;
    width: 620px;
    height: 620px;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.2), transparent 62%);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero-banner-grid {
      grid-template-columns: 1fr;
      padding: 2.25rem 1.5rem;
      gap: 1.75rem;
    }
  }

  @media (max-width: 480px) {
    .hero-banner-grid {
      padding: 1.75rem 1.25rem;
    }
  }

  .hero-banner-content h1 {
    color: var(--gelap-teks);
    font-size: 3.25rem;
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 800;
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .hero-banner-content p {
    color: var(--gelap-teks-lembut);
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 1.75rem;
    max-width: 34rem;
    text-wrap: pretty;
  }

  /* Skala judul di layar sempit. Nilainya sama dengan aturan `h1` global untuk
     lebar yang sama — ia ditulis lagi di sini hanya karena aturan hero di atas
     lebih spesifik dan akan menang tanpa itu. */
  @media (max-width: 1100px) {
    .hero-banner-content h1 {
      font-size: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .hero-banner-content h1 {
      font-size: 1.75rem;
    }
  }

  @media (max-width: 400px) {
    .hero-banner-content h1 {
      font-size: 1.5rem;
    }
  }

  /* Chip di dalam hero selalu berdiri di atas gradien gelap, apa pun temanya.
     Rona aksen akan hilang di sana — sama seperti pada `.share-btn`. */
  .hero-banner-grid .chip {
    --kilau-warna: rgba(255, 255, 255, 0.18);
    --kilau-puncak: rgba(255, 255, 255, 0.42);
  }

  .hero-visual-frame {
    position: relative;
    aspect-ratio: var(--ratio-visual);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: rgba(15, 23, 42, 0.4);
  }

  /* `:global` karena `<img>`-nya dirender komponen lain (`Ilustrasi`), sehingga
     atribut scoped Astro tidak pernah dipasang padanya. */
  .hero-visual-frame :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .hero-visual-frame:hover :global(img) {
    transform: scale(1.03);
  }

  .badge--emerald {
    background: var(--emerald-primary);
    color: #ffffff;
  }

  .badge--aksen {
    background: var(--accent-subtle);
    color: var(--accent-primary);
  }

  .baris-aksi {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Ukuran ketiga ajakan ditulis SEKALI. Tiga salinan `min-height`/`padding`
     yang sepakat hari ini adalah tiga salinan yang akan berbeda pada hari
     seseorang menyesuaikan salah satunya. */
  .chip--ajakan,
  .chip--ajakan-samar,
  .chip--ajakan-pekat {
    min-height: 44px;
    padding: 0.7rem 1.4rem;
    font-size: 0.98rem;
    font-weight: 700;
  }

  /* Ajakan utama: hijau pekat dengan teks gelap di atasnya. Pasangan warna ini
     dipilih agar kontrasnya tetap terbaca di atas gradien hero yang gelap. */
  .chip--ajakan {
    background: var(--gelap-emerald);
    color: var(--gelap-emerald-teks);
    border: none;
  }

  .chip--ajakan:hover,
  .chip--ajakan:focus-visible {
    background: #34d399;
    color: var(--gelap-emerald-teks);
  }

  /* Ajakan kedua: bergaris saja, supaya hierarki kedua tombol terbaca sebelum
     salah satunya dibaca. */
  .chip--ajakan-samar {
    background: transparent;
    border-color: var(--gelap-garis-kuat);
    color: var(--gelap-teks);
    --kilau-warna: rgba(255, 255, 255, 0.16);
    --kilau-puncak: rgba(255, 255, 255, 0.38);
  }

  .chip--ajakan-samar:hover,
  .chip--ajakan-samar:focus-visible {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.5);
    color: var(--gelap-teks);
  }

  /* Ajakan pada permukaan TERANG (sorotan). Ia gelap di tema terang dan aksen
     di tema gelap, jadi ia memakai token bertema — tidak seperti dua di atas,
     yang selalu berdiri di atas hero. */
  .chip--ajakan-pekat {
    align-self: flex-start;
    background: var(--text-primary);
    border-color: transparent;
    color: var(--bg-surface);
    --kilau-warna: rgba(255, 255, 255, 0.16);
    --kilau-puncak: rgba(255, 255, 255, 0.38);
  }

  .chip--ajakan-pekat:hover,
  .chip--ajakan-pekat:focus-visible {
    background: var(--accent-primary);
    border-color: transparent;
    color: #ffffff;
  }

  /* Tiga janji situs, di bawah tombol hero. `list-style: none` + baris mendatar,
