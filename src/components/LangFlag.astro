---
import { localeMeta, type Locale } from '../config/site';

interface Props {
  locale: Locale;
  /** Dipakai untuk id clipPath agar tetap unik bila komponen dirender berkali-kali. */
  uid?: string;
}

const { locale, uid = locale } = Astro.props;

// SVG inline, bukan emoji bendera: Windows tidak merender regional indicator
// sehingga 🇮🇩 tampil sebagai huruf "ID".
//
// Template ini hanya membawa dua bendera. Yang penting bukan jumlahnya,
// melainkan apa yang terjadi pada locale KETIGA: versi sebelumnya memakai
// `locale === 'en' ? bendera Inggris : bendera Indonesia`, jadi locale apa pun
// yang ditambahkan sebuah situs — bahasa apa pun, negara mana pun — otomatis
// mendapat Merah Putih tanpa satu pun peringatan. Sekarang locale tanpa bendera
// di sini mendapat lencana kode ISO-nya: netral, terbaca, dan jelas-jelas
// menyatakan "bendera belum ditambahkan" alih-alih mengaku bendera negara lain.
// Beranotasi `string`, bukan dibiarkan menyempit ke union dua literal yang
// kebetulan ada di `localeMeta` hari ini. Tanpa anotasi ini cabang ketiga
// menyempit ke `never` dan typecheck menolaknya — padahal cabang itu justru
// yang menangani locale yang belum ada.
const iso: string = localeMeta[locale].iso;
const clipId = `bendera-${uid}`;
---

{iso === 'en' ? (
  <svg class="lang-flag" viewBox="0 0 60 40" role="img" aria-hidden="true" focusable="false">
    <clipPath id={clipId}>
      <path d="M30,20 h30 v20 z v20 h-30 z h-30 v-20 z v-20 h30 z" />
    </clipPath>
    <rect width="60" height="40" fill="#012169" />
    <path d="M0,0 L60,40 M60,0 L0,40" stroke="#FFFFFF" stroke-width="8" />
    <path d="M0,0 L60,40 M60,0 L0,40" clip-path={`url(#${clipId})`} stroke="#C8102E" stroke-width="5" />
    <path d="M30,0 V40 M0,20 H60" stroke="#FFFFFF" stroke-width="13" />
    <path d="M30,0 V40 M0,20 H60" stroke="#C8102E" stroke-width="8" />
    <rect x="0.5" y="0.5" width="59" height="39" fill="none" stroke="rgba(0,0,0,0.18)" stroke-width="1" />
  </svg>
) : iso === 'id' ? (
  <svg class="lang-flag" viewBox="0 0 60 40" role="img" aria-hidden="true" focusable="false">
    <rect width="60" height="20" fill="#CE1126" />
    <rect y="20" width="60" height="20" fill="#FFFFFF" />
    <rect x="0.5" y="0.5" width="59" height="39" fill="none" stroke="rgba(0,0,0,0.18)" stroke-width="1" />
  </svg>
) : (
  <span class="lang-flag lang-flag-kode" aria-hidden="true">{iso.toUpperCase()}</span>
)}
