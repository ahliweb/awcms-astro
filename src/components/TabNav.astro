---
/**
 * Navigasi utama.
 *
 * Labelnya lewat katalog PO seperti seluruh string antarmuka lain. Versi
 * sebelumnya merender `tab.name` — nilai HURUF BESAR yang ditulis langsung di
 * `src/config/site.ts` — sehingga navigasi utama justru satu-satunya permukaan
 * yang tidak pernah ikut berganti bahasa. `tab.label` hanya dipakai bila
 * key-nya belum ada di katalog mana pun.
 */
import { siteConfig, getLocaleFromPath, localePath, tabTitleKey } from '../config/site';
import { t } from '../lib/po';

interface Props {
  currentTab?: string;
}

const { currentTab } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
---

<nav class="tab-nav-container" aria-label={t(locale, 'nav.aria')}>
  {siteConfig.tabs.map((tab) => {
    const href = localePath(locale, `/${tab.slug}/`);
    const isActive = currentTab === tab.slug;
    return (
      <a
        href={href}
        class="tab-link"
        aria-current={isActive ? 'page' : undefined}
      >
        <span>{t(locale, tabTitleKey(tab.slug), tab.label)}</span>
      </a>
    );
  })}
</nav>
