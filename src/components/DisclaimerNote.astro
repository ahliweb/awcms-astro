---
/**
 * Penafian situs.
 *
 * Pernah ada varian ketiga, `gakkum`, sisa repo rujukan: satu-satunya
 * pemanggilnya adalah `data.kategori === 'gakkum'` di ArtikelLayout, sementara
 * tab template ini `panduan`/`layanan`/`informasi` — jadi ia tidak pernah bisa
 * tampil. Kelima key katalognya juga tidak pernah ditulis, jadi seandainya ia
 * tampil ia akan memuntahkan nama key mentah ke layar. Dihapus daripada
 * dilengkapi: varian yang isinya khas satu domain bukan milik template.
 */
import { getLocaleFromPath } from '../config/site';
import { t } from '../lib/po';

interface Props {
  variant?: 'general' | 'footer';
}

const { variant = 'general' } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
---

{variant === 'footer' && (
  <div style="font-size: 0.825rem; color: var(--text-muted); line-height: 1.5;">
    <p style="margin-bottom: 0.5rem;">
      <strong>{t(locale, 'disclaimer.footer.label')}</strong> {t(locale, 'disclaimer.footer.p1')}
    </p>
    <p style="margin: 0;">
      {t(locale, 'disclaimer.footer.p2')}
    </p>
  </div>
)}

{variant === 'general' && (
  <aside class="disclaimer-box" aria-label={t(locale, 'disclaimer.general.aria')}>
    <strong>⚠️ {t(locale, 'disclaimer.general.label')}</strong> {t(locale, 'disclaimer.general.body')}
  </aside>
)}
