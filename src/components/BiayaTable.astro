---
import { getLocaleFromPath } from '../config/site';
import { t } from '../lib/po';

interface BiayaItem {
  item: string;
  nominal: string;
  /**
   * Kategori biaya, apa adanya dari `contentJson`. Sengaja `string` dan bukan
   * union empat nilai repo rujukan (`pnbp`, `pajak-daerah`, …): kontrak
   * `AwcmsAstroBlock` di `src/lib/content.ts` juga `string`, dan redaksi mana
   * pun bebas memakai kategori miliknya sendiri.
   */
  jenis: string;
  sumber: string;
}

interface Props {
  biaya: BiayaItem[];
  dasarHukum?: string[];
}

const { biaya = [], dasarHukum = [] } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);

/**
 * Nama kategori: katalog dulu, nilai mentahnya sebagai jaring pengaman.
 *
 * Tidak satu pun key `biaya.jenis.*` pernah ditulis di kedua katalog, dan
 * `t()` tanpa fallback mengembalikan NAMA KEY-nya — jadi tabel biaya
 * menampilkan lencana bertuliskan "biaya.jenis.pnbp" kepada pembaca, di kedua
 * bahasa, tanpa satu pun kegagalan build. Fallback ke nilai mentah membuat
 * kategori yang belum diterjemahkan tetap terbaca sebagai kata.
 */
function namaJenis(jenis: string): string {
  return t(locale, `biaya.jenis.${jenis}`, jenis);
}

function getBadgeClass(jenis: string) {
  switch (jenis) {
    case 'pnbp': return 'badge badge-pnbp';
    case 'pajak-daerah': return 'badge badge-pajak';
    default: return 'badge';
  }
}
---

{(biaya.length > 0 || dasarHukum.length > 0) && (
  <div class="my-6">
    <h3 class="judul-ikon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
      {t(locale, 'biaya.title')}
    </h3>

    {biaya.length > 0 && (
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">{t(locale, 'biaya.col.item')}</th>
              <th scope="col">{t(locale, 'biaya.col.kategori')}</th>
              <th scope="col">{t(locale, 'biaya.col.nominal')}</th>
              <th scope="col">{t(locale, 'biaya.col.sumber')}</th>
            </tr>
          </thead>
          <tbody>
            {biaya.map((b) => (
              <tr>
                <td class="sel-item">{b.item}</td>
                <td>
                  <span class={getBadgeClass(b.jenis)}>
                    {namaJenis(b.jenis)}
                  </span>
                </td>
                <td class="sel-nominal">{b.nominal}</td>
                <td class="sel-sumber">{b.sumber}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {dasarHukum.length > 0 && (
      <div class="kotak-dasar-hukum">
        <strong class="kotak-dasar-hukum-judul">{t(locale, 'biaya.dasarHukum')}</strong>
        <ul class="daftar-dasar-hukum">
          {dasarHukum.map((dh) => (
            <li>{dh}</li>
          ))}
        </ul>
      </div>
    )}
  </div>
)}

<style>
  .sel-item {
    font-weight: 600;
  }

  .sel-nominal {
    font-family: monospace;
    font-weight: 600;
    color: var(--text-primary);
  }

  .sel-sumber {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .kotak-dasar-hukum {
    background: var(--bg-subtle);
    padding: 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    margin-top: 1rem;
  }

  .kotak-dasar-hukum-judul {
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .daftar-dasar-hukum {
    padding-left: 1.25rem;
    color: var(--text-secondary);
    margin: 0;
  }
</style>
